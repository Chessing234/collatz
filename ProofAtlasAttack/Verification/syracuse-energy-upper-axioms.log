def CollatzTargetDensity.SyracuseEnergy.collisionEnergy : ℕ → ℝ :=
fun n => 3 ^ n * ∑ y, ((Erdos1135.Tao.syracPMF n) y).toReal ^ 2
CollatzTargetDensity.SyracuseEnergy.collisionEnergy_step_le_five_thirds (n : ℕ) :
  CollatzTargetDensity.SyracuseEnergy.collisionEnergy (n + 1) ≤
    5 / 3 * CollatzTargetDensity.SyracuseEnergy.collisionEnergy n
CollatzTargetDensity.SyracuseEnergy.collisionEnergy_le_five_thirds_pow (n : ℕ) :
  CollatzTargetDensity.SyracuseEnergy.collisionEnergy n ≤ (5 / 3) ^ n
CollatzTargetDensity.five_thirds_target_density (A : ℕ) (hA : 1 ≤ A) :
  ∃ K,
    1 ≤ K ∧
      ∃ d,
        0 < d ∧
          ∀ (a : ℕ),
            0 < a →
              a % 3 ≠ 0 →
                ∀ (t : ℕ),
                  1 ≤ t →
                    a ≤ t ^ A →
                      ∃ X₀,
                        ∀ (X : ℕ),
                          X₀ ≤ X → d / (↑a ^ 2 * (5 / 3) ^ (K * t)) * ↑X ≤ ↑(CollatzTargetDensity.countBelow a X)
