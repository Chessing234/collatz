def CollatzTargetDensity.DescentVsConvergence.badFirstDrop : Set ℕ :=
{n | n ∈ CollatzTargetDensity.rawBad ∧ Erdos1135.collatzStep n < n}
CollatzTargetDensity.DescentVsConvergence.bad_first_drop_positive_density
  (hbad : CollatzTargetDensity.rawBad.Nonempty) :
  ∃ c,
    0 < c ∧
      ∃ X₀,
        ∀ (X : ℕ),
          X₀ ≤ X → c * ↑X ≤ ↑(Erdos1135.Terras.natCount CollatzTargetDensity.DescentVsConvergence.badFirstDrop X)
CollatzTargetDensity.DescentVsConvergence.first_drop_implies_convergence_iff_collatz :
  (∀ (n : ℕ), 0 < n → Erdos1135.collatzStep n < n → Erdos1135.Reaches n 1) ↔ Erdos1135.collatzProp
