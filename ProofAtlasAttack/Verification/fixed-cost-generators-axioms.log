def CollatzTargetDensity.FixedCostGenerators.generator : (n : ℕ) → ZMod (3 ^ n) → Polynomial ℕ :=
fun x x_1 =>
  Nat.brecOn (motive := fun x => ZMod (3 ^ x) → Polynomial ℕ) x CollatzTargetDensity.FixedCostGenerators.generator._f
    x_1
def CollatzTargetDensity.FixedCostGenerators.geometricProduct : ℕ → ℝ :=
fun n => ∏ i ∈ Finset.range n, (1 - (1 / 2) ^ CollatzTargetDensity.FixedCostGenerators.period i)
def CollatzTargetDensity.FixedCostGenerators.count : (n : ℕ) → ℕ → ZMod (3 ^ n) → ℕ :=
fun n k r => (CollatzTargetDensity.FixedCostGenerators.generator n r).coeff k
CollatzTargetDensity.FixedCostGenerators.pmf_eq_generator_value (n : ℕ) (r : ZMod (3 ^ n)) :
  ((Erdos1135.Tao.syracPMF n) r).toReal =
    Polynomial.eval₂ (Nat.castRingHom ℝ) (1 / 2) (CollatzTargetDensity.FixedCostGenerators.generator n r) /
      (2 ^ n * CollatzTargetDensity.FixedCostGenerators.geometricProduct n)
CollatzTargetDensity.FixedCostGenerators.uniform_generator_value_lower :
  ∃ c,
    0 < c ∧
      ∀ (n : ℕ),
        1 ≤ n → ∀ (r : ZMod (3 ^ n)), IsUnit r → c * (2 / 3) ^ n ≤ CollatzTargetDensity.FixedCostGenerators.value n r
CollatzTargetDensity.FixedCostGenerators.central_zero_with_positive_value :
  CollatzTargetDensity.FixedCostGenerators.count 12 12 7 = 0 ∧
    0 < CollatzTargetDensity.FixedCostGenerators.count 12 12 1 ∧ 0 < CollatzTargetDensity.FixedCostGenerators.value 12 7
