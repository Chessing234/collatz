def CollatzTargetDensity.OrbitReciprocals.side : ℕ → ℕ :=
fun n => if n % 3 = 2 then 16 * n + 5 else 4 * n + 1
def CollatzTargetDensity.OrbitReciprocals.orbit : ℕ → ℕ → ℕ :=
fun n i => Erdos1135.Tao.syracuse^[i] n
def CollatzTargetDensity.OrbitReciprocals.valuationTotal : ℕ → ℕ → ℕ :=
fun n k => ∑ i ∈ Finset.range k, Erdos1135.Tao.syracuseExponent (CollatzTargetDensity.OrbitReciprocals.orbit n i)
def CollatzTargetDensity.OrbitReciprocals.discrepancy : ℕ → ℕ → ℝ :=
fun n k => ↑k * Real.log 3 - ↑(CollatzTargetDensity.OrbitReciprocals.valuationTotal n k) * Real.log 2
CollatzTargetDensity.OrbitReciprocals.orbit_reciprocals_summable {n : ℕ} (hn : 0 < n)
  (hi : Function.Injective (CollatzTargetDensity.OrbitReciprocals.orbit n)) :
  Summable fun i => 1 / ↑(CollatzTargetDensity.OrbitReciprocals.orbit n i)
CollatzTargetDensity.OrbitReciprocals.discrepancy_tendsto_atTop {n : ℕ} (hn : 0 < n)
  (hi : Function.Injective (CollatzTargetDensity.OrbitReciprocals.orbit n)) :
  Filter.Tendsto (CollatzTargetDensity.OrbitReciprocals.discrepancy n) Filter.atTop Filter.atTop
