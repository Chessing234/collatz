def CollatzTargetDensity.InverseBoundary.rationalRemainder : ℕ → ℕ → ℚ :=
fun n k =>
  2 ^ CollatzTargetDensity.OrbitReciprocals.valuationTotal n k / 3 ^ k *
    ↑(CollatzTargetDensity.OrbitReciprocals.orbit n k)
def CollatzTargetDensity.InverseBoundary.realBoundary : ℕ → ℝ :=
fun n => ↑n * Real.exp (∑' (i : ℕ), CollatzTargetDensity.OrbitReciprocals.correction n i)
def CollatzTargetDensity.TwoTopologyExample.q : ℕ → ℚ :=
fun k => 2 ^ k * ↑(3 ^ k / 2 ^ k) / 3 ^ k
CollatzTargetDensity.InverseBoundary.same_rational_remainders_two_limits {n : ℕ} (hn : Odd n)
  (hi : Function.Injective (CollatzTargetDensity.OrbitReciprocals.orbit n)) :
  0 < CollatzTargetDensity.InverseBoundary.realBoundary n ∧
    Filter.Tendsto (fun k => ↑(CollatzTargetDensity.InverseBoundary.rationalRemainder n k)) Filter.atTop
        (nhds (CollatzTargetDensity.InverseBoundary.realBoundary n)) ∧
      Filter.Tendsto (fun k => ↑(CollatzTargetDensity.InverseBoundary.rationalRemainder n k)) Filter.atTop (nhds 0)
CollatzTargetDensity.InverseBoundary.inverse_real_tsum {n : ℕ} (hn : 0 < n)
  (hi : Function.Injective (CollatzTargetDensity.OrbitReciprocals.orbit n)) :
  ∑' (k : ℕ), CollatzTargetDensity.InverseBoundary.scale n k / 3 =
    CollatzTargetDensity.InverseBoundary.realBoundary n - ↑n
CollatzTargetDensity.TwoTopologyExample.explicit_distinct_limits :
  Filter.Tendsto (fun k => ↑(CollatzTargetDensity.TwoTopologyExample.q k)) Filter.atTop (nhds 1) ∧
    Filter.Tendsto (fun k => ↑(CollatzTargetDensity.TwoTopologyExample.q k)) Filter.atTop (nhds 0)
