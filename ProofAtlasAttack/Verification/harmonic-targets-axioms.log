def CollatzTargetDensity.GeneratorPredecessors.sources : ℕ → ℕ → ℕ → Finset ℕ :=
fun x x_1 x_2 =>
  Nat.brecOn (motive := fun x => ℕ → ℕ → Finset ℕ) x CollatzTargetDensity.GeneratorPredecessors.sources._f x_1 x_2
def CollatzTargetDensity.GeneratorPredecessors.harmonicMass : ℕ → ℕ → ℕ → ℝ :=
fun n K a => ∑ x ∈ CollatzTargetDensity.GeneratorPredecessors.sources n K a, 1 / ↑x
CollatzTargetDensity.HarmonicTargets.uniform_raw_logCountingRatio_lower :
  ∃ d,
    0 < d ∧
      ∃ A,
        1 ≤ A ∧
          ∀ (a : ℕ),
            a % 3 ≠ 0 →
              ∀ (X : ℕ), (A * a) ^ 2 ≤ X → d / ↑a ≤ Erdos1135.Tao.logCountingRatio (CollatzTargetDensity.rawReaches a) X
CollatzTargetDensity.HarmonicTargets.least_bad_forces_harmonic_tail :
  ∃ d,
    0 < d ∧
      ∃ B,
        1 ≤ B ∧
          ∀ (m : ℕ),
            CollatzTargetDensity.ProofChain.LeastBad m →
              ∀ (X : ℕ),
                (B * m) ^ 2 ≤ X →
                  d / ↑m ≤ Erdos1135.Tao.logCountingRatio (CollatzTargetDensity.ProofChain.avoidsBelow m) X
