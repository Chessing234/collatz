def CollatzTargetDensity.residueCountBelow : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun target modulus residue X =>
  Nat.count (fun n => CollatzTargetDensity.reachesTarget target n ∧ n % modulus = residue) X
CollatzTargetDensity.positive_density_in_progression_iff (target p q r : ℕ) (hpos : 0 < target)
  (hr : r < 2 ^ p * 3 ^ q) :
  (∃ c,
      0 < c ∧ ∃ X₀, ∀ (X : ℕ), X₀ ≤ X → c * ↑X ≤ ↑(CollatzTargetDensity.residueCountBelow target (2 ^ p * 3 ^ q) r X)) ↔
    target % 3 ≠ 0
CollatzTargetDensity.collatz_iff_sparse_bad_in_one_mixed_class (p q : ℕ) (r : Fin (2 ^ p * 3 ^ q)) :
  (∀ (n : ℕ), 0 < n → Erdos1135.Reaches n 1) ↔ CollatzTargetDensity.SparseBadInMixedClass p q r
