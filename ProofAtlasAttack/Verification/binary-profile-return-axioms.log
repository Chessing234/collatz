def CollatzTargetDensity.BinaryProfileReturn.histogram : ℕ → ℕ → CollatzTargetDensity.BinaryProfileReturn.Histogram :=
fun k n =>
  CollatzTargetDensity.BinaryPatternPotential.normalize
    (List.map (fun p => (p, 1)) (CollatzTargetDensity.BinaryPatternPotential.patterns k n))
def CollatzTargetDensity.BinaryProfileReturn.checkpoint : ℕ → ℕ :=
fun n => Erdos1135.Tao.syracuse^[padicValNat 2 (n + 1)] n
CollatzTargetDensity.BinaryProfileReturn.no_strict_checkpoint_descent (k : ℕ) (hk : 1 ≤ k) (hK : k ≤ 5)
  (F : CollatzTargetDensity.BinaryProfileReturn.Histogram → ℕ → ℝ)
  (hF : ∀ (p : CollatzTargetDensity.BinaryProfileReturn.Histogram), Monotone (F p)) :
  ¬∀ (n : ℕ),
      1 < n →
        Odd n →
          F
              (CollatzTargetDensity.BinaryProfileReturn.histogram k
                (CollatzTargetDensity.BinaryProfileReturn.checkpoint n))
