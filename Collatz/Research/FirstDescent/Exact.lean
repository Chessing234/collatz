import Collatz.Research.FirstDescent.All
import Collatz.Research.FirstDescent.PrefixTransport

namespace Collatz.Research.FirstDescent.Exact
open Collatz
open Collatz.Research.FirstDescent

/-- Exact first descent for every member of cylinder (4, 3). -/
theorem first_4_3 (m : Nat) :
    acceleratedOrbit 4 (2 ^ 4 * m + 3) < 2 ^ 4 * m + 3 ∧
    ∀ j, j < 4 → 2 ^ 4 * m + 3 ≤
      acceleratedOrbit j (2 ^ 4 * m + 3) := by
  apply first_descent_transport
  · rw [Batch001.data_4_3.1]; decide
  · rw [Batch001.data_4_3.2.1]; decide
  · have hp : ∀ j : Fin 4, 2 ^ j.val ≤ 3 ^ oddCount 3 j.val ∧
        3 ≤ acceleratedOrbit j.val 3 := by decide
    intro j hj
    exact hp ⟨j, hj⟩

