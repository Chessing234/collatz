/-- Exact parity count, endpoint, and contracting multiplier for residue 4781. -/
theorem data_4781 : oddCount 4781 14 = 5 ∧
    acceleratedOrbit 14 4781 = 71 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4781 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4781) = 243 * m + 71 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4781
  rw [data_4781.1, data_4781.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4781 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4781) < 16384 * m + 4781 := by
  apply descent_of_endpoint
  · rw [data_4781.1]; exact data_4781.2.2
  · rw [data_4781.2.1]; decide

