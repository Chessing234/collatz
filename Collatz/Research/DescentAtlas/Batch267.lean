/-- Exact parity count, endpoint, and contracting multiplier for residue 5981. -/
theorem data_5981 : oddCount 5981 14 = 7 ∧
    acceleratedOrbit 14 5981 = 800 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5981 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5981) = 2187 * m + 800 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5981
  rw [data_5981.1, data_5981.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5981 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5981) < 16384 * m + 5981 := by
  apply descent_of_endpoint
  · rw [data_5981.1]; exact data_5981.2.2
  · rw [data_5981.2.1]; decide

