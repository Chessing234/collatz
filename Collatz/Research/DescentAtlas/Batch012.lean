/-- Exact parity count, endpoint, and contracting multiplier for residue 277. -/
theorem data_277 : oddCount 277 14 = 4 ∧
    acceleratedOrbit 14 277 = 2 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_277 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 277) = 81 * m + 2 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 277
  rw [data_277.1, data_277.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_277 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 277) < 16384 * m + 277 := by
  apply descent_of_endpoint
  · rw [data_277.1]; exact data_277.2.2
  · rw [data_277.2.1]; decide

