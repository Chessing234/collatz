/-- Exact parity count, endpoint, and contracting multiplier for residue 2683. -/
theorem data_2683 : oddCount 2683 14 = 7 ∧
    acceleratedOrbit 14 2683 = 359 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2683 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2683) = 2187 * m + 359 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2683
  rw [data_2683.1, data_2683.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2683 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2683) < 16384 * m + 2683 := by
  apply descent_of_endpoint
  · rw [data_2683.1]; exact data_2683.2.2
  · rw [data_2683.2.1]; decide

