/-- Exact parity count, endpoint, and contracting multiplier for residue 1465. -/
theorem data_1465 : oddCount 1465 14 = 5 ∧
    acceleratedOrbit 14 1465 = 22 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1465 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1465) = 243 * m + 22 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1465
  rw [data_1465.1, data_1465.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1465 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1465) < 16384 * m + 1465 := by
  apply descent_of_endpoint
  · rw [data_1465.1]; exact data_1465.2.2
  · rw [data_1465.2.1]; decide

