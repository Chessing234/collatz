/-- Exact parity count, endpoint, and contracting multiplier for residue 3363. -/
theorem data_3363 : oddCount 3363 14 = 5 ∧
    acceleratedOrbit 14 3363 = 50 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3363 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3363) = 243 * m + 50 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3363
  rw [data_3363.1, data_3363.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3363 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3363) < 16384 * m + 3363 := by
  apply descent_of_endpoint
  · rw [data_3363.1]; exact data_3363.2.2
  · rw [data_3363.2.1]; decide

