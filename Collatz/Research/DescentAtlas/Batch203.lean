/-- Exact parity count, endpoint, and contracting multiplier for residue 4557. -/
theorem data_4557 : oddCount 4557 14 = 7 ∧
    acceleratedOrbit 14 4557 = 611 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4557 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4557) = 2187 * m + 611 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4557
  rw [data_4557.1, data_4557.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4557 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4557) < 16384 * m + 4557 := by
  apply descent_of_endpoint
  · rw [data_4557.1]; exact data_4557.2.2
  · rw [data_4557.2.1]; decide

