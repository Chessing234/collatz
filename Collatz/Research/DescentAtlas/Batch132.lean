/-- Exact parity count, endpoint, and contracting multiplier for residue 2961. -/
theorem data_2961 : oddCount 2961 14 = 5 ∧
    acceleratedOrbit 14 2961 = 44 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2961 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2961) = 243 * m + 44 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2961
  rw [data_2961.1, data_2961.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2961 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2961) < 16384 * m + 2961 := by
  apply descent_of_endpoint
  · rw [data_2961.1]; exact data_2961.2.2
  · rw [data_2961.2.1]; decide

