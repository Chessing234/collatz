/-- Exact parity count, endpoint, and contracting multiplier for residue 325. -/
theorem data_325 : oddCount 325 14 = 5 ∧
    acceleratedOrbit 14 325 = 5 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_325 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 325) = 243 * m + 5 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 325
  rw [data_325.1, data_325.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_325 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 325) < 16384 * m + 325 := by
  apply descent_of_endpoint
  · rw [data_325.1]; exact data_325.2.2
  · rw [data_325.2.1]; decide

