/-- Exact parity count, endpoint, and contracting multiplier for residue 1233. -/
theorem data_1233 : oddCount 1233 14 = 8 ∧
    acceleratedOrbit 14 1233 = 496 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1233 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1233) = 6561 * m + 496 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1233
  rw [data_1233.1, data_1233.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1233 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1233) < 16384 * m + 1233 := by
  apply descent_of_endpoint
  · rw [data_1233.1]; exact data_1233.2.2
  · rw [data_1233.2.1]; decide

