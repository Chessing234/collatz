/-- Exact parity count, endpoint, and contracting multiplier for residue 229. -/
theorem data_229 : oddCount 229 14 = 6 ∧
    acceleratedOrbit 14 229 = 11 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_229 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 229) = 729 * m + 11 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 229
  rw [data_229.1, data_229.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_229 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 229) < 16384 * m + 229 := by
  apply descent_of_endpoint
  · rw [data_229.1]; exact data_229.2.2
  · rw [data_229.2.1]; decide

