    acceleratedOrbit 14 3389 = 151 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3389 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3389) = 729 * m + 151 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3389
  rw [data_3389.1, data_3389.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3389 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3389) < 16384 * m + 3389 := by
  apply descent_of_endpoint
  · rw [data_3389.1]; exact data_3389.2.2
  · rw [data_3389.2.1]; decide

