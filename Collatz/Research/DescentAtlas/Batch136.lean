/-- Exact parity count, endpoint, and contracting multiplier for residue 3051. -/
theorem data_3051 : oddCount 3051 14 = 8 ∧
    acceleratedOrbit 14 3051 = 1223 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3051 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3051) = 6561 * m + 1223 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3051
  rw [data_3051.1, data_3051.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3051 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3051) < 16384 * m + 3051 := by
  apply descent_of_endpoint
  · rw [data_3051.1]; exact data_3051.2.2
  · rw [data_3051.2.1]; decide

