/-- Exact parity count, endpoint, and contracting multiplier for residue 2835. -/
theorem data_2835 : oddCount 2835 14 = 7 ∧
    acceleratedOrbit 14 2835 = 379 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2835 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2835) = 2187 * m + 379 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2835
  rw [data_2835.1, data_2835.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2835 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2835) < 16384 * m + 2835 := by
  apply descent_of_endpoint
  · rw [data_2835.1]; exact data_2835.2.2
  · rw [data_2835.2.1]; decide

