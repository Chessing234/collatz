/-- Exact parity count, endpoint, and contracting multiplier for residue 4145. -/
theorem data_4145 : oddCount 4145 14 = 8 ∧
    acceleratedOrbit 14 4145 = 1664 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4145 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4145) = 6561 * m + 1664 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4145
  rw [data_4145.1, data_4145.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4145 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4145) < 16384 * m + 4145 := by
  apply descent_of_endpoint
  · rw [data_4145.1]; exact data_4145.2.2
  · rw [data_4145.2.1]; decide

