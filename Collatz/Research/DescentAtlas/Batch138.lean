/-- Exact parity count, endpoint, and contracting multiplier for residue 3091. -/
theorem data_3091 : oddCount 3091 14 = 8 ∧
    acceleratedOrbit 14 3091 = 1241 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3091 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3091) = 6561 * m + 1241 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3091
  rw [data_3091.1, data_3091.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3091 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3091) < 16384 * m + 3091 := by
  apply descent_of_endpoint
  · rw [data_3091.1]; exact data_3091.2.2
  · rw [data_3091.2.1]; decide

