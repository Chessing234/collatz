/-- Exact parity count, endpoint, and contracting multiplier for residue 6633. -/
theorem data_6633 : oddCount 6633 14 = 8 ∧
    acceleratedOrbit 14 6633 = 2657 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6633 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6633) = 6561 * m + 2657 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6633
  rw [data_6633.1, data_6633.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6633 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6633) < 16384 * m + 6633 := by
  apply descent_of_endpoint
  · rw [data_6633.1]; exact data_6633.2.2
  · rw [data_6633.2.1]; decide

