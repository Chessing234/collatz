/-- Exact parity count, endpoint, and contracting multiplier for residue 3697. -/
theorem data_3697 : oddCount 3697 14 = 5 ∧
    acceleratedOrbit 14 3697 = 56 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3697 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3697) = 243 * m + 56 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3697
  rw [data_3697.1, data_3697.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3697 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3697) < 16384 * m + 3697 := by
  apply descent_of_endpoint
  · rw [data_3697.1]; exact data_3697.2.2
  · rw [data_3697.2.1]; decide

