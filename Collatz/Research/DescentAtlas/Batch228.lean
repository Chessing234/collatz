/-- Exact parity count, endpoint, and contracting multiplier for residue 5121. -/
theorem data_5121 : oddCount 5121 14 = 5 ∧
    acceleratedOrbit 14 5121 = 76 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5121 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5121) = 243 * m + 76 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5121
  rw [data_5121.1, data_5121.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5121 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5121) < 16384 * m + 5121 := by
  apply descent_of_endpoint
  · rw [data_5121.1]; exact data_5121.2.2
  · rw [data_5121.2.1]; decide

