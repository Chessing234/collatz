/-- Exact parity count, endpoint, and contracting multiplier for residue 4855. -/
theorem data_4855 : oddCount 4855 14 = 8 ∧
    acceleratedOrbit 14 4855 = 1946 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4855 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4855) = 6561 * m + 1946 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4855
  rw [data_4855.1, data_4855.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4855 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4855) < 16384 * m + 4855 := by
  apply descent_of_endpoint
  · rw [data_4855.1]; exact data_4855.2.2
  · rw [data_4855.2.1]; decide

