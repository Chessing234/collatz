/-- Exact parity count, endpoint, and contracting multiplier for residue 5009. -/
theorem data_5009 : oddCount 5009 14 = 7 ∧
    acceleratedOrbit 14 5009 = 670 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5009 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5009) = 2187 * m + 670 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5009
  rw [data_5009.1, data_5009.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5009 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5009) < 16384 * m + 5009 := by
  apply descent_of_endpoint
  · rw [data_5009.1]; exact data_5009.2.2
  · rw [data_5009.2.1]; decide

