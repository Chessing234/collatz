/-- Exact parity count, endpoint, and contracting multiplier for residue 6231. -/
theorem data_6231 : oddCount 6231 14 = 6 ∧
    acceleratedOrbit 14 6231 = 278 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6231 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6231) = 729 * m + 278 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6231
  rw [data_6231.1, data_6231.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6231 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6231) < 16384 * m + 6231 := by
  apply descent_of_endpoint
  · rw [data_6231.1]; exact data_6231.2.2
  · rw [data_6231.2.1]; decide

