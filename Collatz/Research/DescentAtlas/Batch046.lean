import Collatz.Research.DescentAtlas.Core

/-! Batch 46: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch046
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 1033. -/
theorem data_1033 : oddCount 1033 14 = 8 ∧
    acceleratedOrbit 14 1033 = 415 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1033 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1033) = 6561 * m + 415 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1033
  rw [data_1033.1, data_1033.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1033 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1033) < 16384 * m + 1033 := by
  apply descent_of_endpoint
  · rw [data_1033.1]; exact data_1033.2.2
  · rw [data_1033.2.1]; decide

