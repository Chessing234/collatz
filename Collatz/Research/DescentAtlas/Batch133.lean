/-- Exact parity count, endpoint, and contracting multiplier for residue 2979. -/
theorem data_2979 : oddCount 2979 14 = 6 ∧
    acceleratedOrbit 14 2979 = 134 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2979 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2979) = 729 * m + 134 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2979
  rw [data_2979.1, data_2979.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2979 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2979) < 16384 * m + 2979 := by
  apply descent_of_endpoint
  · rw [data_2979.1]; exact data_2979.2.2
  · rw [data_2979.2.1]; decide

