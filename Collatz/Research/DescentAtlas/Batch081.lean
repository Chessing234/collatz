/-- Exact parity count, endpoint, and contracting multiplier for residue 1807. -/
theorem data_1807 : oddCount 1807 14 = 8 ∧
    acceleratedOrbit 14 1807 = 728 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1807 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1807) = 6561 * m + 728 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1807
  rw [data_1807.1, data_1807.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1807 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1807) < 16384 * m + 1807 := by
  apply descent_of_endpoint
  · rw [data_1807.1]; exact data_1807.2.2
  · rw [data_1807.2.1]; decide

