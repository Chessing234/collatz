import Collatz.Research.DescentAtlas.Core

/-! Batch 84: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch084
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 1871. -/
theorem data_1871 : oddCount 1871 14 = 7 ∧
    acceleratedOrbit 14 1871 = 250 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1871 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1871) = 2187 * m + 250 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1871
  rw [data_1871.1, data_1871.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1871 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1871) < 16384 * m + 1871 := by
  apply descent_of_endpoint
  · rw [data_1871.1]; exact data_1871.2.2
  · rw [data_1871.2.1]; decide

