/-- Exact parity count, endpoint, and contracting multiplier for residue 545. -/
theorem data_545 : oddCount 545 14 = 7 ∧
    acceleratedOrbit 14 545 = 74 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_545 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 545) = 2187 * m + 74 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 545
  rw [data_545.1, data_545.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_545 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 545) < 16384 * m + 545 := by
  apply descent_of_endpoint
  · rw [data_545.1]; exact data_545.2.2
  · rw [data_545.2.1]; decide

