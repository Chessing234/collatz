/-- Exact parity count, endpoint, and contracting multiplier for residue 4231. -/
theorem data_4231 : oddCount 4231 14 = 8 ∧
    acceleratedOrbit 14 4231 = 1696 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4231 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4231) = 6561 * m + 1696 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4231
  rw [data_4231.1, data_4231.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4231 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4231) < 16384 * m + 4231 := by
  apply descent_of_endpoint
  · rw [data_4231.1]; exact data_4231.2.2
  · rw [data_4231.2.1]; decide

