/-- Exact parity count, endpoint, and contracting multiplier for residue 4689. -/
theorem data_4689 : oddCount 4689 14 = 8 ∧
    acceleratedOrbit 14 4689 = 1880 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4689 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4689) = 6561 * m + 1880 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4689
  rw [data_4689.1, data_4689.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4689 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4689) < 16384 * m + 4689 := by
  apply descent_of_endpoint
  · rw [data_4689.1]; exact data_4689.2.2
  · rw [data_4689.2.1]; decide

