/-- Exact parity count, endpoint, and contracting multiplier for residue 1833. -/
theorem data_1833 : oddCount 1833 14 = 7 ∧
    acceleratedOrbit 14 1833 = 245 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1833 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1833) = 2187 * m + 245 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1833
  rw [data_1833.1, data_1833.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1833 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1833) < 16384 * m + 1833 := by
  apply descent_of_endpoint
  · rw [data_1833.1]; exact data_1833.2.2
  · rw [data_1833.2.1]; decide

