/-- Exact parity count, endpoint, and contracting multiplier for residue 4281. -/
theorem data_4281 : oddCount 4281 14 = 7 ∧
    acceleratedOrbit 14 4281 = 572 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4281 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4281) = 2187 * m + 572 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4281
  rw [data_4281.1, data_4281.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4281 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4281) < 16384 * m + 4281 := by
  apply descent_of_endpoint
  · rw [data_4281.1]; exact data_4281.2.2
  · rw [data_4281.2.1]; decide

