/-- Exact parity count, endpoint, and contracting multiplier for residue 3075. -/
theorem data_3075 : oddCount 3075 14 = 8 ∧
    acceleratedOrbit 14 3075 = 1235 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3075 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3075) = 6561 * m + 1235 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3075
  rw [data_3075.1, data_3075.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3075 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3075) < 16384 * m + 3075 := by
  apply descent_of_endpoint
  · rw [data_3075.1]; exact data_3075.2.2
  · rw [data_3075.2.1]; decide

