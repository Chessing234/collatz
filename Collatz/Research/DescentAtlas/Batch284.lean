/-- Exact parity count, endpoint, and contracting multiplier for residue 6377. -/
theorem data_6377 : oddCount 6377 14 = 8 ∧
    acceleratedOrbit 14 6377 = 2555 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6377 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6377) = 6561 * m + 2555 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6377
  rw [data_6377.1, data_6377.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6377 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6377) < 16384 * m + 6377 := by
  apply descent_of_endpoint
  · rw [data_6377.1]; exact data_6377.2.2
  · rw [data_6377.2.1]; decide

