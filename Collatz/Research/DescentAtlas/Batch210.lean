/-- Exact parity count, endpoint, and contracting multiplier for residue 4707. -/
theorem data_4707 : oddCount 4707 14 = 5 ∧
    acceleratedOrbit 14 4707 = 70 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4707 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4707) = 243 * m + 70 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4707
  rw [data_4707.1, data_4707.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4707 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4707) < 16384 * m + 4707 := by
  apply descent_of_endpoint
  · rw [data_4707.1]; exact data_4707.2.2
  · rw [data_4707.2.1]; decide

