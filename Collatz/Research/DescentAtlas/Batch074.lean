/-- Exact parity count, endpoint, and contracting multiplier for residue 1641. -/
theorem data_1641 : oddCount 1641 14 = 8 ∧
    acceleratedOrbit 14 1641 = 658 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1641 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1641) = 6561 * m + 658 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1641
  rw [data_1641.1, data_1641.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1641 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1641) < 16384 * m + 1641 := by
  apply descent_of_endpoint
  · rw [data_1641.1]; exact data_1641.2.2
  · rw [data_1641.2.1]; decide

