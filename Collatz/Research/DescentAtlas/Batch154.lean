/-- Exact parity count, endpoint, and contracting multiplier for residue 3453. -/
theorem data_3453 : oddCount 3453 14 = 6 ∧
    acceleratedOrbit 14 3453 = 154 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3453 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3453) = 729 * m + 154 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3453
  rw [data_3453.1, data_3453.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3453 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3453) < 16384 * m + 3453 := by
  apply descent_of_endpoint
  · rw [data_3453.1]; exact data_3453.2.2
  · rw [data_3453.2.1]; decide

