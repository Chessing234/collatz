/-- Exact parity count, endpoint, and contracting multiplier for residue 1297. -/
theorem data_1297 : oddCount 1297 14 = 7 ∧
    acceleratedOrbit 14 1297 = 175 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1297 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1297) = 2187 * m + 175 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1297
  rw [data_1297.1, data_1297.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1297 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1297) < 16384 * m + 1297 := by
  apply descent_of_endpoint
  · rw [data_1297.1]; exact data_1297.2.2
  · rw [data_1297.2.1]; decide

