/-- Exact parity count, endpoint, and contracting multiplier for residue 5517. -/
theorem data_5517 : oddCount 5517 14 = 5 ∧
    acceleratedOrbit 14 5517 = 83 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5517 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5517) = 243 * m + 83 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5517
  rw [data_5517.1, data_5517.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5517 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5517) < 16384 * m + 5517 := by
  apply descent_of_endpoint
  · rw [data_5517.1]; exact data_5517.2.2
  · rw [data_5517.2.1]; decide

