    acceleratedOrbit 14 4119 = 184 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4119 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4119) = 729 * m + 184 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4119
  rw [data_4119.1, data_4119.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4119 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4119) < 16384 * m + 4119 := by
  apply descent_of_endpoint
  · rw [data_4119.1]; exact data_4119.2.2
  · rw [data_4119.2.1]; decide

