import Collatz.Research.DescentAtlas.Core

/-! Batch 3: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch003
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 39. -/
theorem data_39 : oddCount 39 14 = 8 ∧
    acceleratedOrbit 14 39 = 17 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_39 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 39) = 6561 * m + 17 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 39
  rw [data_39.1, data_39.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_39 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 39) < 16384 * m + 39 := by
  apply descent_of_endpoint
  · rw [data_39.1]; exact data_39.2.2
  · rw [data_39.2.1]; decide

