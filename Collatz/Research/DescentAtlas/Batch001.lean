import Collatz.Research.DescentAtlas.Core

/-! Batch 1: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch001
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 3. -/
theorem data_3 : oddCount 3 14 = 7 ∧
    acceleratedOrbit 14 3 = 2 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3) = 2187 * m + 2 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3
  rw [data_3.1, data_3.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3) < 16384 * m + 3 := by
  apply descent_of_endpoint
  · rw [data_3.1]; exact data_3.2.2
  · rw [data_3.2.1]; decide

