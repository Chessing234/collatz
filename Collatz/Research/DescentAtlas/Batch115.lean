/-- Exact parity count, endpoint, and contracting multiplier for residue 2583. -/
theorem data_2583 : oddCount 2583 14 = 7 ∧
    acceleratedOrbit 14 2583 = 346 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2583 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2583) = 2187 * m + 346 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2583
  rw [data_2583.1, data_2583.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2583 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2583) < 16384 * m + 2583 := by
  apply descent_of_endpoint
  · rw [data_2583.1]; exact data_2583.2.2
  · rw [data_2583.2.1]; decide

