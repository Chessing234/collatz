    acceleratedOrbit 14 5561 = 83 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5561 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5561) = 243 * m + 83 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5561
  rw [data_5561.1, data_5561.2.1] at h
