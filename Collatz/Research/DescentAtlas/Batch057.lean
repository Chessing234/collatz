/-- Exact parity count, endpoint, and contracting multiplier for residue 1271. -/
theorem data_1271 : oddCount 1271 14 = 8 ∧
    acceleratedOrbit 14 1271 = 512 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1271 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1271) = 6561 * m + 512 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1271
  rw [data_1271.1, data_1271.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1271 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1271) < 16384 * m + 1271 := by
  apply descent_of_endpoint
  · rw [data_1271.1]; exact data_1271.2.2
  · rw [data_1271.2.1]; decide

