/-- Exact parity count, endpoint, and contracting multiplier for residue 2007. -/
theorem data_2007 : oddCount 2007 14 = 8 ∧
    acceleratedOrbit 14 2007 = 805 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2007 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2007) = 6561 * m + 805 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2007
  rw [data_2007.1, data_2007.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2007 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2007) < 16384 * m + 2007 := by
  apply descent_of_endpoint
  · rw [data_2007.1]; exact data_2007.2.2
  · rw [data_2007.2.1]; decide

