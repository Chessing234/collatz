/-- Exact parity count, endpoint, and contracting multiplier for residue 3745. -/
theorem data_3745 : oddCount 3745 14 = 8 ∧
    acceleratedOrbit 14 3745 = 1502 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3745 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3745) = 6561 * m + 1502 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3745
  rw [data_3745.1, data_3745.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3745 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3745) < 16384 * m + 3745 := by
  apply descent_of_endpoint
  · rw [data_3745.1]; exact data_3745.2.2
  · rw [data_3745.2.1]; decide

