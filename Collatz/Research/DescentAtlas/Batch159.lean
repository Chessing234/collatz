/-- Exact parity count, endpoint, and contracting multiplier for residue 3559. -/
theorem data_3559 : oddCount 3559 14 = 8 ∧
    acceleratedOrbit 14 3559 = 1426 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3559 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3559) = 6561 * m + 1426 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3559
  rw [data_3559.1, data_3559.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3559 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3559) < 16384 * m + 3559 := by
  apply descent_of_endpoint
  · rw [data_3559.1]; exact data_3559.2.2
  · rw [data_3559.2.1]; decide

