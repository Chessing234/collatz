/-- Exact parity count, endpoint, and contracting multiplier for residue 3491. -/
theorem data_3491 : oddCount 3491 14 = 8 ∧
    acceleratedOrbit 14 3491 = 1403 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3491 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3491) = 6561 * m + 1403 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3491
  rw [data_3491.1, data_3491.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3491 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3491) < 16384 * m + 3491 := by
  apply descent_of_endpoint
  · rw [data_3491.1]; exact data_3491.2.2
  · rw [data_3491.2.1]; decide

