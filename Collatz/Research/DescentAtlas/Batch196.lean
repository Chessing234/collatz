/-- Exact parity count, endpoint, and contracting multiplier for residue 4401. -/
theorem data_4401 : oddCount 4401 14 = 7 ∧
    acceleratedOrbit 14 4401 = 589 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4401 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4401) = 2187 * m + 589 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4401
  rw [data_4401.1, data_4401.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4401 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4401) < 16384 * m + 4401 := by
  apply descent_of_endpoint
  · rw [data_4401.1]; exact data_4401.2.2
  · rw [data_4401.2.1]; decide

