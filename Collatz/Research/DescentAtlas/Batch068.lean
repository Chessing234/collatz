/-- Exact parity count, endpoint, and contracting multiplier for residue 1517. -/
theorem data_1517 : oddCount 1517 14 = 8 ∧
    acceleratedOrbit 14 1517 = 611 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1517 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1517) = 6561 * m + 611 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1517
  rw [data_1517.1, data_1517.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1517 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1517) < 16384 * m + 1517 := by
  apply descent_of_endpoint
  · rw [data_1517.1]; exact data_1517.2.2
  · rw [data_1517.2.1]; decide

