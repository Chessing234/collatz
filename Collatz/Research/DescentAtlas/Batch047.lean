/-- Exact parity count, endpoint, and contracting multiplier for residue 1049. -/
theorem data_1049 : oddCount 1049 14 = 8 ∧
    acceleratedOrbit 14 1049 = 422 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1049 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1049) = 6561 * m + 422 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1049
  rw [data_1049.1, data_1049.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1049 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1049) < 16384 * m + 1049 := by
  apply descent_of_endpoint
  · rw [data_1049.1]; exact data_1049.2.2
  · rw [data_1049.2.1]; decide

