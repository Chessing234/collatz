/-- Exact parity count, endpoint, and contracting multiplier for residue 6279. -/
theorem data_6279 : oddCount 6279 14 = 7 ∧
    acceleratedOrbit 14 6279 = 839 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6279 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6279) = 2187 * m + 839 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6279
  rw [data_6279.1, data_6279.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6279 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6279) < 16384 * m + 6279 := by
  apply descent_of_endpoint
  · rw [data_6279.1]; exact data_6279.2.2
  · rw [data_6279.2.1]; decide

