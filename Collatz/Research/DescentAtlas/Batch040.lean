/-- Exact parity count, endpoint, and contracting multiplier for residue 903. -/
theorem data_903 : oddCount 903 14 = 8 ∧
    acceleratedOrbit 14 903 = 364 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_903 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 903) = 6561 * m + 364 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 903
  rw [data_903.1, data_903.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_903 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 903) < 16384 * m + 903 := by
  apply descent_of_endpoint
  · rw [data_903.1]; exact data_903.2.2
  · rw [data_903.2.1]; decide

