/-- Exact parity count, endpoint, and contracting multiplier for residue 413. -/
theorem data_413 : oddCount 413 14 = 8 ∧
    acceleratedOrbit 14 413 = 167 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_413 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 413) = 6561 * m + 167 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 413
  rw [data_413.1, data_413.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_413 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 413) < 16384 * m + 413 := by
  apply descent_of_endpoint
  · rw [data_413.1]; exact data_413.2.2
  · rw [data_413.2.1]; decide

