/-- Exact parity count, endpoint, and contracting multiplier for residue 5463. -/
theorem data_5463 : oddCount 5463 14 = 7 ∧
    acceleratedOrbit 14 5463 = 730 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5463 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5463) = 2187 * m + 730 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5463
  rw [data_5463.1, data_5463.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5463 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5463) < 16384 * m + 5463 := by
  apply descent_of_endpoint
  · rw [data_5463.1]; exact data_5463.2.2
  · rw [data_5463.2.1]; decide

