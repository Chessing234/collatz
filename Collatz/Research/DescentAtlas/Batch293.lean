/-- Exact parity count, endpoint, and contracting multiplier for residue 6563. -/
theorem data_6563 : oddCount 6563 14 = 8 ∧
    acceleratedOrbit 14 6563 = 2632 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6563 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6563) = 6561 * m + 2632 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6563
  rw [data_6563.1, data_6563.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6563 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6563) < 16384 * m + 6563 := by
  apply descent_of_endpoint
  · rw [data_6563.1]; exact data_6563.2.2
  · rw [data_6563.2.1]; decide

