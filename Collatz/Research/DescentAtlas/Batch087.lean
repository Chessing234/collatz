import Collatz.Research.DescentAtlas.Core

/-! Batch 87: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch087
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 1937. -/
theorem data_1937 : oddCount 1937 14 = 7 ∧
    acceleratedOrbit 14 1937 = 260 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1937 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1937) = 2187 * m + 260 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1937
  rw [data_1937.1, data_1937.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1937 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1937) < 16384 * m + 1937 := by
  apply descent_of_endpoint
  · rw [data_1937.1]; exact data_1937.2.2
  · rw [data_1937.2.1]; decide

