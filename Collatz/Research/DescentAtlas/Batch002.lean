import Collatz.Research.DescentAtlas.Core

/-! Batch 2: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch002
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 19. -/
theorem data_19 : oddCount 19 14 = 6 ∧
    acceleratedOrbit 14 19 = 1 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_19 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 19) = 729 * m + 1 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 19
  rw [data_19.1, data_19.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_19 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 19) < 16384 * m + 19 := by
  apply descent_of_endpoint
  · rw [data_19.1]; exact data_19.2.2
  · rw [data_19.2.1]; decide

