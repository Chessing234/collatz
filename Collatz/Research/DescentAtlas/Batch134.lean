/-- Exact parity count, endpoint, and contracting multiplier for residue 2999. -/
theorem data_2999 : oddCount 2999 14 = 6 ∧
    acceleratedOrbit 14 2999 = 134 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2999 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2999) = 729 * m + 134 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2999
  rw [data_2999.1, data_2999.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2999 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2999) < 16384 * m + 2999 := by
  apply descent_of_endpoint
  · rw [data_2999.1]; exact data_2999.2.2
  · rw [data_2999.2.1]; decide

