/-- Exact parity count, endpoint, and contracting multiplier for residue 2897. -/
theorem data_2897 : oddCount 2897 14 = 8 ∧
    acceleratedOrbit 14 2897 = 1162 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2897 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2897) = 6561 * m + 1162 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2897
  rw [data_2897.1, data_2897.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2897 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2897) < 16384 * m + 2897 := by
  apply descent_of_endpoint
  · rw [data_2897.1]; exact data_2897.2.2
  · rw [data_2897.2.1]; decide

