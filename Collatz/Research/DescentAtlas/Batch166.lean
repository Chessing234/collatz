/-- Exact parity count, endpoint, and contracting multiplier for residue 3719. -/
theorem data_3719 : oddCount 3719 14 = 7 ∧
    acceleratedOrbit 14 3719 = 497 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3719 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3719) = 2187 * m + 497 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3719
  rw [data_3719.1, data_3719.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3719 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3719) < 16384 * m + 3719 := by
  apply descent_of_endpoint
  · rw [data_3719.1]; exact data_3719.2.2
  · rw [data_3719.2.1]; decide

