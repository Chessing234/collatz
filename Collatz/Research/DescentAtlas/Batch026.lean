/-- Exact parity count, endpoint, and contracting multiplier for residue 587. -/
theorem data_587 : oddCount 587 14 = 8 ∧
    acceleratedOrbit 14 587 = 242 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_587 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 587) = 6561 * m + 242 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 587
  rw [data_587.1, data_587.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_587 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 587) < 16384 * m + 587 := by
  apply descent_of_endpoint
  · rw [data_587.1]; exact data_587.2.2
  · rw [data_587.2.1]; decide

