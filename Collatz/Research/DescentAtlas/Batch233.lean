/-- Exact parity count, endpoint, and contracting multiplier for residue 5219. -/
theorem data_5219 : oddCount 5219 14 = 8 ∧
    acceleratedOrbit 14 5219 = 2096 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5219 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5219) = 6561 * m + 2096 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5219
  rw [data_5219.1, data_5219.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5219 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5219) < 16384 * m + 5219 := by
  apply descent_of_endpoint
  · rw [data_5219.1]; exact data_5219.2.2
  · rw [data_5219.2.1]; decide

