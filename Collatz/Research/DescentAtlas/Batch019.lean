/-- Exact parity count, endpoint, and contracting multiplier for residue 437. -/
theorem data_437 : oddCount 437 14 = 8 ∧
    acceleratedOrbit 14 437 = 182 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_437 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 437) = 6561 * m + 182 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 437
  rw [data_437.1, data_437.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_437 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 437) < 16384 * m + 437 := by
  apply descent_of_endpoint
  · rw [data_437.1]; exact data_437.2.2
  · rw [data_437.2.1]; decide

