/-- Exact parity count, endpoint, and contracting multiplier for residue 6485. -/
theorem data_6485 : oddCount 6485 14 = 3 ∧
    acceleratedOrbit 14 6485 = 11 ∧ 27 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6485 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6485) = 27 * m + 11 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6485
  rw [data_6485.1, data_6485.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6485 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6485) < 16384 * m + 6485 := by
  apply descent_of_endpoint
  · rw [data_6485.1]; exact data_6485.2.2
  · rw [data_6485.2.1]; decide

