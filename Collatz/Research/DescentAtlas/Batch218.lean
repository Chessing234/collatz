/-- Exact parity count, endpoint, and contracting multiplier for residue 4897. -/
theorem data_4897 : oddCount 4897 14 = 8 ∧
    acceleratedOrbit 14 4897 = 1964 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4897 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4897) = 6561 * m + 1964 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4897
  rw [data_4897.1, data_4897.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4897 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4897) < 16384 * m + 4897 := by
  apply descent_of_endpoint
  · rw [data_4897.1]; exact data_4897.2.2
  · rw [data_4897.2.1]; decide

