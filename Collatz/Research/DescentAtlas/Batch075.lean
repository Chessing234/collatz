/-- Exact parity count, endpoint, and contracting multiplier for residue 1657. -/
theorem data_1657 : oddCount 1657 14 = 8 ∧
    acceleratedOrbit 14 1657 = 665 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1657 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1657) = 6561 * m + 665 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1657
  rw [data_1657.1, data_1657.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1657 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1657) < 16384 * m + 1657 := by
  apply descent_of_endpoint
  · rw [data_1657.1]; exact data_1657.2.2
  · rw [data_1657.2.1]; decide

