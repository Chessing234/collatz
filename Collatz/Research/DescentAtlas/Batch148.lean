/-- Exact parity count, endpoint, and contracting multiplier for residue 3313. -/
theorem data_3313 : oddCount 3313 14 = 7 ∧
    acceleratedOrbit 14 3313 = 445 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3313 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3313) = 2187 * m + 445 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3313
  rw [data_3313.1, data_3313.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3313 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3313) < 16384 * m + 3313 := by
  apply descent_of_endpoint
  · rw [data_3313.1]; exact data_3313.2.2
  · rw [data_3313.2.1]; decide

