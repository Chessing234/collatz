/-- Exact parity count, endpoint, and contracting multiplier for residue 4939. -/
theorem data_4939 : oddCount 4939 14 = 7 ∧
    acceleratedOrbit 14 4939 = 661 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4939 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4939) = 2187 * m + 661 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4939
  rw [data_4939.1, data_4939.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4939 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4939) < 16384 * m + 4939 := by
  apply descent_of_endpoint
  · rw [data_4939.1]; exact data_4939.2.2
  · rw [data_4939.2.1]; decide

