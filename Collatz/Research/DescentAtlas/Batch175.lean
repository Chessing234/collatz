/-- Exact parity count, endpoint, and contracting multiplier for residue 3925. -/
theorem data_3925 : oddCount 3925 14 = 4 ∧
    acceleratedOrbit 14 3925 = 20 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3925 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3925) = 81 * m + 20 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3925
  rw [data_3925.1, data_3925.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3925 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3925) < 16384 * m + 3925 := by
  apply descent_of_endpoint
  · rw [data_3925.1]; exact data_3925.2.2
  · rw [data_3925.2.1]; decide

