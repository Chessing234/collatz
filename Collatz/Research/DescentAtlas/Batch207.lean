    acceleratedOrbit 14 4651 = 23 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4651 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4651) = 81 * m + 23 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4651
  rw [data_4651.1, data_4651.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4651 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4651) < 16384 * m + 4651 := by
  apply descent_of_endpoint
  · rw [data_4651.1]; exact data_4651.2.2
  · rw [data_4651.2.1]; decide

