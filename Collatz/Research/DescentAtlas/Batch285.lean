/-- Exact parity count, endpoint, and contracting multiplier for residue 6403. -/
theorem data_6403 : oddCount 6403 14 = 8 ∧
    acceleratedOrbit 14 6403 = 2567 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6403 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6403) = 6561 * m + 2567 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6403
  rw [data_6403.1, data_6403.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6403 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6403) < 16384 * m + 6403 := by
  apply descent_of_endpoint
  · rw [data_6403.1]; exact data_6403.2.2
  · rw [data_6403.2.1]; decide

