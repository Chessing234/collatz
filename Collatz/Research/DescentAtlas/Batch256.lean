/-- Exact parity count, endpoint, and contracting multiplier for residue 5749. -/
theorem data_5749 : oddCount 5749 14 = 8 ∧
    acceleratedOrbit 14 5749 = 2308 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5749 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5749) = 6561 * m + 2308 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5749
  rw [data_5749.1, data_5749.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5749 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5749) < 16384 * m + 5749 := by
  apply descent_of_endpoint
  · rw [data_5749.1]; exact data_5749.2.2
  · rw [data_5749.2.1]; decide

