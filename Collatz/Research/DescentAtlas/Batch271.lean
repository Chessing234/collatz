/-- Exact parity count, endpoint, and contracting multiplier for residue 6077. -/
theorem data_6077 : oddCount 6077 14 = 8 ∧
    acceleratedOrbit 14 6077 = 2435 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6077 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6077) = 6561 * m + 2435 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6077
  rw [data_6077.1, data_6077.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6077 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6077) < 16384 * m + 6077 := by
  apply descent_of_endpoint
  · rw [data_6077.1]; exact data_6077.2.2
  · rw [data_6077.2.1]; decide

