/-- Exact parity count, endpoint, and contracting multiplier for residue 2293. -/
theorem data_2293 : oddCount 2293 14 = 6 ∧
    acceleratedOrbit 14 2293 = 103 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2293 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2293) = 729 * m + 103 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2293
  rw [data_2293.1, data_2293.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2293 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2293) < 16384 * m + 2293 := by
  apply descent_of_endpoint
  · rw [data_2293.1]; exact data_2293.2.2
  · rw [data_2293.2.1]; decide

