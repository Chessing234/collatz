/-- Exact parity count, endpoint, and contracting multiplier for residue 6611. -/
theorem data_6611 : oddCount 6611 14 = 7 ∧
    acceleratedOrbit 14 6611 = 883 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6611 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6611) = 2187 * m + 883 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6611
  rw [data_6611.1, data_6611.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6611 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6611) < 16384 * m + 6611 := by
  apply descent_of_endpoint
  · rw [data_6611.1]; exact data_6611.2.2
  · rw [data_6611.2.1]; decide

