/-- Exact parity count, endpoint, and contracting multiplier for residue 1683. -/
theorem data_1683 : oddCount 1683 14 = 5 ∧
    acceleratedOrbit 14 1683 = 25 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1683 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1683) = 243 * m + 25 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1683
  rw [data_1683.1, data_1683.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1683 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1683) < 16384 * m + 1683 := by
  apply descent_of_endpoint
  · rw [data_1683.1]; exact data_1683.2.2
  · rw [data_1683.2.1]; decide

