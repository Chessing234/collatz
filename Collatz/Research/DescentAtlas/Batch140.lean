/-- Exact parity count, endpoint, and contracting multiplier for residue 3133. -/
theorem data_3133 : oddCount 3133 14 = 5 ∧
    acceleratedOrbit 14 3133 = 47 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3133 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3133) = 243 * m + 47 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3133
  rw [data_3133.1, data_3133.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3133 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3133) < 16384 * m + 3133 := by
  apply descent_of_endpoint
  · rw [data_3133.1]; exact data_3133.2.2
  · rw [data_3133.2.1]; decide

