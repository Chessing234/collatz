/-- Exact parity count, endpoint, and contracting multiplier for residue 5047. -/
theorem data_5047 : oddCount 5047 14 = 8 ∧
    acceleratedOrbit 14 5047 = 2024 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5047 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5047) = 6561 * m + 2024 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5047
  rw [data_5047.1, data_5047.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5047 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5047) < 16384 * m + 5047 := by
  apply descent_of_endpoint
  · rw [data_5047.1]; exact data_5047.2.2
  · rw [data_5047.2.1]; decide

