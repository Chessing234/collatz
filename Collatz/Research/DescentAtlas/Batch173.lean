/-- Exact parity count, endpoint, and contracting multiplier for residue 3887. -/
theorem data_3887 : oddCount 3887 14 = 6 ∧
    acceleratedOrbit 14 3887 = 173 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3887 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3887) = 729 * m + 173 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3887
  rw [data_3887.1, data_3887.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3887 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3887) < 16384 * m + 3887 := by
  apply descent_of_endpoint
  · rw [data_3887.1]; exact data_3887.2.2
  · rw [data_3887.2.1]; decide

