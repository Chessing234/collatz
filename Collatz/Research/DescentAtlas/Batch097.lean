/-- Exact parity count, endpoint, and contracting multiplier for residue 2179. -/
theorem data_2179 : oddCount 2179 14 = 6 ∧
    acceleratedOrbit 14 2179 = 98 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2179 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2179) = 729 * m + 98 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2179
  rw [data_2179.1, data_2179.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2179 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2179) < 16384 * m + 2179 := by
  apply descent_of_endpoint
  · rw [data_2179.1]; exact data_2179.2.2
  · rw [data_2179.2.1]; decide

