/-- Exact parity count, endpoint, and contracting multiplier for residue 4299. -/
theorem data_4299 : oddCount 4299 14 = 7 ∧
    acceleratedOrbit 14 4299 = 575 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4299 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4299) = 2187 * m + 575 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4299
  rw [data_4299.1, data_4299.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4299 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4299) < 16384 * m + 4299 := by
  apply descent_of_endpoint
  · rw [data_4299.1]; exact data_4299.2.2
  · rw [data_4299.2.1]; decide

