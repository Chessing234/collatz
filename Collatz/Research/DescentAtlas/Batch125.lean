/-- Exact parity count, endpoint, and contracting multiplier for residue 2807. -/
theorem data_2807 : oddCount 2807 14 = 6 ∧
    acceleratedOrbit 14 2807 = 125 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2807 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2807) = 729 * m + 125 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2807
  rw [data_2807.1, data_2807.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2807 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2807) < 16384 * m + 2807 := by
  apply descent_of_endpoint
  · rw [data_2807.1]; exact data_2807.2.2
  · rw [data_2807.2.1]; decide

