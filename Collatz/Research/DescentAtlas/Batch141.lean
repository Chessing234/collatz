/-- Exact parity count, endpoint, and contracting multiplier for residue 3153. -/
theorem data_3153 : oddCount 3153 14 = 7 ∧
    acceleratedOrbit 14 3153 = 422 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3153 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3153) = 2187 * m + 422 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3153
  rw [data_3153.1, data_3153.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3153 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3153) < 16384 * m + 3153 := by
  apply descent_of_endpoint
  · rw [data_3153.1]; exact data_3153.2.2
  · rw [data_3153.2.1]; decide

