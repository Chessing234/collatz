/-- Exact parity count, endpoint, and contracting multiplier for residue 4445. -/
theorem data_4445 : oddCount 4445 14 = 4 ∧
    acceleratedOrbit 14 4445 = 22 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4445 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4445) = 81 * m + 22 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4445
  rw [data_4445.1, data_4445.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4445 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4445) < 16384 * m + 4445 := by
  apply descent_of_endpoint
  · rw [data_4445.1]; exact data_4445.2.2
  · rw [data_4445.2.1]; decide

