/-- Exact parity count, endpoint, and contracting multiplier for residue 4531. -/
theorem data_4531 : oddCount 4531 14 = 7 ∧
    acceleratedOrbit 14 4531 = 607 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4531 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4531) = 2187 * m + 607 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4531
  rw [data_4531.1, data_4531.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4531 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4531) < 16384 * m + 4531 := by
  apply descent_of_endpoint
  · rw [data_4531.1]; exact data_4531.2.2
  · rw [data_4531.2.1]; decide

