/-- Exact parity count, endpoint, and contracting multiplier for residue 6117. -/
theorem data_6117 : oddCount 6117 14 = 7 ∧
    acceleratedOrbit 14 6117 = 818 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6117 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6117) = 2187 * m + 818 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6117
  rw [data_6117.1, data_6117.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6117 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6117) < 16384 * m + 6117 := by
  apply descent_of_endpoint
  · rw [data_6117.1]; exact data_6117.2.2
  · rw [data_6117.2.1]; decide

