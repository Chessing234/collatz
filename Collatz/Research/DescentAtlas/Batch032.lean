/-- Exact parity count, endpoint, and contracting multiplier for residue 715. -/
theorem data_715 : oddCount 715 14 = 6 ∧
    acceleratedOrbit 14 715 = 32 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_715 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 715) = 729 * m + 32 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 715
  rw [data_715.1, data_715.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_715 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 715) < 16384 * m + 715 := by
  apply descent_of_endpoint
  · rw [data_715.1]; exact data_715.2.2
  · rw [data_715.2.1]; decide

