/-- Exact parity count, endpoint, and contracting multiplier for residue 4029. -/
theorem data_4029 : oddCount 4029 14 = 8 ∧
    acceleratedOrbit 14 4029 = 1615 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4029 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4029) = 6561 * m + 1615 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4029
  rw [data_4029.1, data_4029.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4029 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4029) < 16384 * m + 4029 := by
  apply descent_of_endpoint
  · rw [data_4029.1]; exact data_4029.2.2
  · rw [data_4029.2.1]; decide

