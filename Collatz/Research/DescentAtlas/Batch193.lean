    acceleratedOrbit 14 4323 = 22 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4323 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4323) = 81 * m + 22 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4323
  rw [data_4323.1, data_4323.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4323 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4323) < 16384 * m + 4323 := by
  apply descent_of_endpoint
  · rw [data_4323.1]; exact data_4323.2.2
  · rw [data_4323.2.1]; decide

