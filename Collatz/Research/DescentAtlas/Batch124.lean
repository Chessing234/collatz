/-- Exact parity count, endpoint, and contracting multiplier for residue 2775. -/
theorem data_2775 : oddCount 2775 14 = 7 ∧
    acceleratedOrbit 14 2775 = 371 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2775 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2775) = 2187 * m + 371 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2775
  rw [data_2775.1, data_2775.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2775 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2775) < 16384 * m + 2775 := by
  apply descent_of_endpoint
  · rw [data_2775.1]; exact data_2775.2.2
  · rw [data_2775.2.1]; decide

