/-- Exact parity count, endpoint, and contracting multiplier for residue 4729. -/
theorem data_4729 : oddCount 4729 14 = 7 ∧
    acceleratedOrbit 14 4729 = 632 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4729 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4729) = 2187 * m + 632 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4729
  rw [data_4729.1, data_4729.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4729 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4729) < 16384 * m + 4729 := by
  apply descent_of_endpoint
  · rw [data_4729.1]; exact data_4729.2.2
  · rw [data_4729.2.1]; decide

