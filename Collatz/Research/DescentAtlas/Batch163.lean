/-- Exact parity count, endpoint, and contracting multiplier for residue 3659. -/
theorem data_3659 : oddCount 3659 14 = 6 ∧
    acceleratedOrbit 14 3659 = 164 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3659 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3659) = 729 * m + 164 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3659
  rw [data_3659.1, data_3659.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3659 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3659) < 16384 * m + 3659 := by
  apply descent_of_endpoint
  · rw [data_3659.1]; exact data_3659.2.2
  · rw [data_3659.2.1]; decide

