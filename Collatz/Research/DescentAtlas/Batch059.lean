/-- Exact parity count, endpoint, and contracting multiplier for residue 1319. -/
theorem data_1319 : oddCount 1319 14 = 8 ∧
    acceleratedOrbit 14 1319 = 530 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1319 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1319) = 6561 * m + 530 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1319
  rw [data_1319.1, data_1319.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1319 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1319) < 16384 * m + 1319 := by
  apply descent_of_endpoint
  · rw [data_1319.1]; exact data_1319.2.2
  · rw [data_1319.2.1]; decide

