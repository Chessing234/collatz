/-- Exact parity count, endpoint, and contracting multiplier for residue 1541. -/
theorem data_1541 : oddCount 1541 14 = 5 ∧
    acceleratedOrbit 14 1541 = 23 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1541 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1541) = 243 * m + 23 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1541
  rw [data_1541.1, data_1541.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1541 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1541) < 16384 * m + 1541 := by
  apply descent_of_endpoint
  · rw [data_1541.1]; exact data_1541.2.2
  · rw [data_1541.2.1]; decide

