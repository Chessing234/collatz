/-- Exact parity count, endpoint, and contracting multiplier for residue 853. -/
theorem data_853 : oddCount 853 14 = 3 ∧
    acceleratedOrbit 14 853 = 2 ∧ 27 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_853 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 853) = 27 * m + 2 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 853
  rw [data_853.1, data_853.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_853 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 853) < 16384 * m + 853 := by
  apply descent_of_endpoint
  · rw [data_853.1]; exact data_853.2.2
  · rw [data_853.2.1]; decide

