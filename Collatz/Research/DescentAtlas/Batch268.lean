/-- Exact parity count, endpoint, and contracting multiplier for residue 6003. -/
theorem data_6003 : oddCount 6003 14 = 7 ∧
    acceleratedOrbit 14 6003 = 803 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6003 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6003) = 2187 * m + 803 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6003
  rw [data_6003.1, data_6003.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6003 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6003) < 16384 * m + 6003 := by
  apply descent_of_endpoint
  · rw [data_6003.1]; exact data_6003.2.2
  · rw [data_6003.2.1]; decide

