/-- Exact parity count, endpoint, and contracting multiplier for residue 2079. -/
theorem data_2079 : oddCount 2079 14 = 8 ∧
    acceleratedOrbit 14 2079 = 833 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2079 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2079) = 6561 * m + 833 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2079
  rw [data_2079.1, data_2079.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2079 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2079) < 16384 * m + 2079 := by
  apply descent_of_endpoint
  · rw [data_2079.1]; exact data_2079.2.2
  · rw [data_2079.2.1]; decide

