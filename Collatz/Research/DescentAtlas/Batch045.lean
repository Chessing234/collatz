import Collatz.Research.DescentAtlas.Core

/-! Batch 45: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch045
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 1013. -/
theorem data_1013 : oddCount 1013 14 = 7 ∧
    acceleratedOrbit 14 1013 = 137 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1013 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1013) = 2187 * m + 137 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1013
  rw [data_1013.1, data_1013.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1013 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1013) < 16384 * m + 1013 := by
  apply descent_of_endpoint
  · rw [data_1013.1]; exact data_1013.2.2
  · rw [data_1013.2.1]; decide

