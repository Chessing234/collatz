/-- Exact parity count, endpoint, and contracting multiplier for residue 1489. -/
theorem data_1489 : oddCount 1489 14 = 6 ∧
    acceleratedOrbit 14 1489 = 67 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1489 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1489) = 729 * m + 67 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1489
  rw [data_1489.1, data_1489.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1489 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1489) < 16384 * m + 1489 := by
  apply descent_of_endpoint
  · rw [data_1489.1]; exact data_1489.2.2
  · rw [data_1489.2.1]; decide

