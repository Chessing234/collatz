/-- Exact parity count, endpoint, and contracting multiplier for residue 2317. -/
theorem data_2317 : oddCount 2317 14 = 5 ∧
    acceleratedOrbit 14 2317 = 35 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2317 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2317) = 243 * m + 35 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2317
  rw [data_2317.1, data_2317.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2317 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2317) < 16384 * m + 2317 := by
  apply descent_of_endpoint
  · rw [data_2317.1]; exact data_2317.2.2
  · rw [data_2317.2.1]; decide

