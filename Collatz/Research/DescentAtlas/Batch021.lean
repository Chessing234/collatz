/-- Exact parity count, endpoint, and contracting multiplier for residue 477. -/
theorem data_477 : oddCount 477 14 = 6 ∧
    acceleratedOrbit 14 477 = 22 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_477 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 477) = 729 * m + 22 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 477
  rw [data_477.1, data_477.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_477 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 477) < 16384 * m + 477 := by
  apply descent_of_endpoint
  · rw [data_477.1]; exact data_477.2.2
  · rw [data_477.2.1]; decide

