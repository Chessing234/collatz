/-- Exact parity count, endpoint, and contracting multiplier for residue 5353. -/
theorem data_5353 : oddCount 5353 14 = 7 ∧
    acceleratedOrbit 14 5353 = 715 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5353 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5353) = 2187 * m + 715 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5353
  rw [data_5353.1, data_5353.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5353 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5353) < 16384 * m + 5353 := by
  apply descent_of_endpoint
  · rw [data_5353.1]; exact data_5353.2.2
  · rw [data_5353.2.1]; decide

