/-- Exact parity count, endpoint, and contracting multiplier for residue 4373. -/
theorem data_4373 : oddCount 4373 14 = 4 ∧
    acceleratedOrbit 14 4373 = 22 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4373 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4373) = 81 * m + 22 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4373
  rw [data_4373.1, data_4373.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4373 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4373) < 16384 * m + 4373 := by
  apply descent_of_endpoint
  · rw [data_4373.1]; exact data_4373.2.2
  · rw [data_4373.2.1]; decide

