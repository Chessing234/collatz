/-- Exact parity count, endpoint, and contracting multiplier for residue 459. -/
theorem data_459 : oddCount 459 14 = 8 ∧
    acceleratedOrbit 14 459 = 188 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_459 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 459) = 6561 * m + 188 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 459
  rw [data_459.1, data_459.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_459 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 459) < 16384 * m + 459 := by
  apply descent_of_endpoint
  · rw [data_459.1]; exact data_459.2.2
  · rw [data_459.2.1]; decide

