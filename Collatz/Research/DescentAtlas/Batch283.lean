/-- Exact parity count, endpoint, and contracting multiplier for residue 6347. -/
theorem data_6347 : oddCount 6347 14 = 7 ∧
    acceleratedOrbit 14 6347 = 848 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6347 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6347) = 2187 * m + 848 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6347
  rw [data_6347.1, data_6347.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6347 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6347) < 16384 * m + 6347 := by
  apply descent_of_endpoint
  · rw [data_6347.1]; exact data_6347.2.2
  · rw [data_6347.2.1]; decide

