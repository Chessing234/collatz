import Collatz.Research.DescentAtlas.Core

/-! Batch 91: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch091
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 2037. -/
theorem data_2037 : oddCount 2037 14 = 8 ∧
    acceleratedOrbit 14 2037 = 820 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2037 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2037) = 6561 * m + 820 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2037
  rw [data_2037.1, data_2037.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2037 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2037) < 16384 * m + 2037 := by
  apply descent_of_endpoint
  · rw [data_2037.1]; exact data_2037.2.2
  · rw [data_2037.2.1]; decide

