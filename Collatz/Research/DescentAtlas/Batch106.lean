/-- Exact parity count, endpoint, and contracting multiplier for residue 2381. -/
theorem data_2381 : oddCount 2381 14 = 7 ∧
    acceleratedOrbit 14 2381 = 319 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2381 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2381) = 2187 * m + 319 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2381
  rw [data_2381.1, data_2381.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2381 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2381) < 16384 * m + 2381 := by
  apply descent_of_endpoint
  · rw [data_2381.1]; exact data_2381.2.2
  · rw [data_2381.2.1]; decide

