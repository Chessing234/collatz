/-- Exact parity count, endpoint, and contracting multiplier for residue 1851. -/
theorem data_1851 : oddCount 1851 14 = 6 ∧
    acceleratedOrbit 14 1851 = 83 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1851 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1851) = 729 * m + 83 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1851
  rw [data_1851.1, data_1851.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1851 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1851) < 16384 * m + 1851 := by
  apply descent_of_endpoint
  · rw [data_1851.1]; exact data_1851.2.2
  · rw [data_1851.2.1]; decide

