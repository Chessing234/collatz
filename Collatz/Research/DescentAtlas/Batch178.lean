/-- Exact parity count, endpoint, and contracting multiplier for residue 3987. -/
theorem data_3987 : oddCount 3987 14 = 7 ∧
    acceleratedOrbit 14 3987 = 533 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3987 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3987) = 2187 * m + 533 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3987
  rw [data_3987.1, data_3987.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3987 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3987) < 16384 * m + 3987 := by
  apply descent_of_endpoint
  · rw [data_3987.1]; exact data_3987.2.2
  · rw [data_3987.2.1]; decide

