import Collatz.Research.DescentAtlas.Core

/-! Batch 5: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch005
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 85. -/
theorem data_85 : oddCount 85 14 = 4 ∧
    acceleratedOrbit 14 85 = 1 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_85 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 85) = 81 * m + 1 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 85
  rw [data_85.1, data_85.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_85 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 85) < 16384 * m + 85 := by
  apply descent_of_endpoint
  · rw [data_85.1]; exact data_85.2.2
  · rw [data_85.2.1]; decide

