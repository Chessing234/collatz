/-- Exact parity count, endpoint, and contracting multiplier for residue 5425. -/
theorem data_5425 : oddCount 5425 14 = 8 ∧
    acceleratedOrbit 14 5425 = 2177 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5425 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5425) = 6561 * m + 2177 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5425
  rw [data_5425.1, data_5425.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5425 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5425) < 16384 * m + 5425 := by
  apply descent_of_endpoint
  · rw [data_5425.1]; exact data_5425.2.2
  · rw [data_5425.2.1]; decide

