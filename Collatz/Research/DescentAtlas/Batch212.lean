/-- Exact parity count, endpoint, and contracting multiplier for residue 4753. -/
theorem data_4753 : oddCount 4753 14 = 8 ∧
    acceleratedOrbit 14 4753 = 1907 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4753 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4753) = 6561 * m + 1907 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4753
  rw [data_4753.1, data_4753.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4753 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4753) < 16384 * m + 4753 := by
  apply descent_of_endpoint
  · rw [data_4753.1]; exact data_4753.2.2
  · rw [data_4753.2.1]; decide

