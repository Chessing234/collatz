/-- Exact parity count, endpoint, and contracting multiplier for residue 369. -/
theorem data_369 : oddCount 369 14 = 4 ∧
    acceleratedOrbit 14 369 = 2 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_369 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 369) = 81 * m + 2 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 369
  rw [data_369.1, data_369.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_369 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 369) < 16384 * m + 369 := by
  apply descent_of_endpoint
  · rw [data_369.1]; exact data_369.2.2
  · rw [data_369.2.1]; decide

