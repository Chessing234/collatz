/-- Exact parity count, endpoint, and contracting multiplier for residue 3205. -/
theorem data_3205 : oddCount 3205 14 = 7 ∧
    acceleratedOrbit 14 3205 = 431 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3205 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3205) = 2187 * m + 431 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3205
  rw [data_3205.1, data_3205.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3205 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3205) < 16384 * m + 3205 := by
  apply descent_of_endpoint
  · rw [data_3205.1]; exact data_3205.2.2
  · rw [data_3205.2.1]; decide

