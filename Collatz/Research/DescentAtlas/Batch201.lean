import Collatz.Research.DescentAtlas.Core

/-! Batch 201: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch201
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 4503. -/
theorem data_4503 : oddCount 4503 14 = 8 ∧
    acceleratedOrbit 14 4503 = 1808 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4503 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4503) = 6561 * m + 1808 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4503
  rw [data_4503.1, data_4503.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4503 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4503) < 16384 * m + 4503 := by
  apply descent_of_endpoint
  · rw [data_4503.1]; exact data_4503.2.2
  · rw [data_4503.2.1]; decide

