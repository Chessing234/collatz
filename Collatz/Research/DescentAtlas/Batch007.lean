/-- Exact parity count, endpoint, and contracting multiplier for residue 149. -/
theorem data_149 : oddCount 149 14 = 6 ∧
    acceleratedOrbit 14 149 = 8 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_149 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 149) = 729 * m + 8 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 149
  rw [data_149.1, data_149.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_149 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 149) < 16384 * m + 149 := by
  apply descent_of_endpoint
  · rw [data_149.1]; exact data_149.2.2
  · rw [data_149.2.1]; decide

