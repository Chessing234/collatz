/-- Exact parity count, endpoint, and contracting multiplier for residue 3537. -/
theorem data_3537 : oddCount 3537 14 = 5 ∧
    acceleratedOrbit 14 3537 = 53 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3537 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3537) = 243 * m + 53 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3537
  rw [data_3537.1, data_3537.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3537 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3537) < 16384 * m + 3537 := by
  apply descent_of_endpoint
  · rw [data_3537.1]; exact data_3537.2.2
  · rw [data_3537.2.1]; decide

