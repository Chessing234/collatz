/-- Exact parity count, endpoint, and contracting multiplier for residue 2269. -/
theorem data_2269 : oddCount 2269 14 = 8 ∧
    acceleratedOrbit 14 2269 = 911 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2269 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2269) = 6561 * m + 911 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2269
  rw [data_2269.1, data_2269.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2269 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2269) < 16384 * m + 2269 := by
  apply descent_of_endpoint
  · rw [data_2269.1]; exact data_2269.2.2
  · rw [data_2269.2.1]; decide

