/-- Exact parity count, endpoint, and contracting multiplier for residue 1751. -/
theorem data_1751 : oddCount 1751 14 = 5 ∧
    acceleratedOrbit 14 1751 = 26 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1751 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1751) = 243 * m + 26 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1751
  rw [data_1751.1, data_1751.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1751 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1751) < 16384 * m + 1751 := by
  apply descent_of_endpoint
  · rw [data_1751.1]; exact data_1751.2.2
  · rw [data_1751.2.1]; decide

