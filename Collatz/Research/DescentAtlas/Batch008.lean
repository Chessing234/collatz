/-- Exact parity count, endpoint, and contracting multiplier for residue 179. -/
theorem data_179 : oddCount 179 14 = 7 ∧
    acceleratedOrbit 14 179 = 26 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_179 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 179) = 2187 * m + 26 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 179
  rw [data_179.1, data_179.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_179 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 179) < 16384 * m + 179 := by
  apply descent_of_endpoint
  · rw [data_179.1]; exact data_179.2.2
  · rw [data_179.2.1]; decide

