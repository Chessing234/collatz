/-- Exact parity count, endpoint, and contracting multiplier for residue 1599. -/
theorem data_1599 : oddCount 1599 14 = 8 ∧
    acceleratedOrbit 14 1599 = 641 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1599 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1599) = 6561 * m + 641 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1599
  rw [data_1599.1, data_1599.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1599 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1599) < 16384 * m + 1599 := by
  apply descent_of_endpoint
  · rw [data_1599.1]; exact data_1599.2.2
  · rw [data_1599.2.1]; decide

