/-- Exact parity count, endpoint, and contracting multiplier for residue 4977. -/
theorem data_4977 : oddCount 4977 14 = 7 ∧
    acceleratedOrbit 14 4977 = 668 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4977 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4977) = 2187 * m + 668 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4977
  rw [data_4977.1, data_4977.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4977 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4977) < 16384 * m + 4977 := by
  apply descent_of_endpoint
  · rw [data_4977.1]; exact data_4977.2.2
  · rw [data_4977.2.1]; decide

