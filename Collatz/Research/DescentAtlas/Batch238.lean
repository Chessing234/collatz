/-- Exact parity count, endpoint, and contracting multiplier for residue 5329. -/
theorem data_5329 : oddCount 5329 14 = 7 ∧
    acceleratedOrbit 14 5329 = 712 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5329 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5329) = 2187 * m + 712 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5329
  rw [data_5329.1, data_5329.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5329 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5329) < 16384 * m + 5329 := by
  apply descent_of_endpoint
  · rw [data_5329.1]; exact data_5329.2.2
  · rw [data_5329.2.1]; decide

