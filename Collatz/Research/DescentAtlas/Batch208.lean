/-- Exact parity count, endpoint, and contracting multiplier for residue 4673. -/
theorem data_4673 : oddCount 4673 14 = 6 ∧
    acceleratedOrbit 14 4673 = 209 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4673 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4673) = 729 * m + 209 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4673
  rw [data_4673.1, data_4673.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4673 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4673) < 16384 * m + 4673 := by
  apply descent_of_endpoint
  · rw [data_4673.1]; exact data_4673.2.2
  · rw [data_4673.2.1]; decide

