import Collatz.Research.DescentAtlas.Core

/-! Batch 23: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch023
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 525. -/
theorem data_525 : oddCount 525 14 = 6 ∧
    acceleratedOrbit 14 525 = 26 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_525 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 525) = 729 * m + 26 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 525
  rw [data_525.1, data_525.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_525 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 525) < 16384 * m + 525 := by
  apply descent_of_endpoint
  · rw [data_525.1]; exact data_525.2.2
  · rw [data_525.2.1]; decide

