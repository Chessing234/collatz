/-- Exact parity count, endpoint, and contracting multiplier for residue 4103. -/
theorem data_4103 : oddCount 4103 14 = 8 ∧
    acceleratedOrbit 14 4103 = 1646 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4103 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4103) = 6561 * m + 1646 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4103
  rw [data_4103.1, data_4103.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4103 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4103) < 16384 * m + 4103 := by
  apply descent_of_endpoint
  · rw [data_4103.1]; exact data_4103.2.2
  · rw [data_4103.2.1]; decide

