/-- Exact parity count, endpoint, and contracting multiplier for residue 6097. -/
theorem data_6097 : oddCount 6097 14 = 6 ∧
    acceleratedOrbit 14 6097 = 272 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6097 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6097) = 729 * m + 272 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6097
  rw [data_6097.1, data_6097.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6097 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6097) < 16384 * m + 6097 := by
  apply descent_of_endpoint
  · rw [data_6097.1]; exact data_6097.2.2
  · rw [data_6097.2.1]; decide

