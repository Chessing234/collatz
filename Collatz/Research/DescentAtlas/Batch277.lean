/-- Exact parity count, endpoint, and contracting multiplier for residue 6211. -/
theorem data_6211 : oddCount 6211 14 = 7 ∧
    acceleratedOrbit 14 6211 = 830 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6211 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6211) = 2187 * m + 830 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6211
  rw [data_6211.1, data_6211.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6211 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6211) < 16384 * m + 6211 := by
  apply descent_of_endpoint
  · rw [data_6211.1]; exact data_6211.2.2
  · rw [data_6211.2.1]; decide

