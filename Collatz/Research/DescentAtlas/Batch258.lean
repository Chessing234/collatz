/-- Exact parity count, endpoint, and contracting multiplier for residue 5795. -/
theorem data_5795 : oddCount 5795 14 = 8 ∧
    acceleratedOrbit 14 5795 = 2324 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5795 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5795) = 6561 * m + 2324 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5795
  rw [data_5795.1, data_5795.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5795 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5795) < 16384 * m + 5795 := by
  apply descent_of_endpoint
  · rw [data_5795.1]; exact data_5795.2.2
  · rw [data_5795.2.1]; decide

