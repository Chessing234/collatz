/-- Exact parity count, endpoint, and contracting multiplier for residue 1727. -/
theorem data_1727 : oddCount 1727 14 = 8 ∧
    acceleratedOrbit 14 1727 = 692 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1727 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1727) = 6561 * m + 692 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1727
  rw [data_1727.1, data_1727.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1727 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1727) < 16384 * m + 1727 := by
  apply descent_of_endpoint
  · rw [data_1727.1]; exact data_1727.2.2
  · rw [data_1727.2.1]; decide

