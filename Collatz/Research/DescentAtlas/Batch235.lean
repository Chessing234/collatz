/-- Exact parity count, endpoint, and contracting multiplier for residue 5269. -/
theorem data_5269 : oddCount 5269 14 = 6 ∧
    acceleratedOrbit 14 5269 = 236 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5269 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5269) = 729 * m + 236 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5269
  rw [data_5269.1, data_5269.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5269 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5269) < 16384 * m + 5269 := by
  apply descent_of_endpoint
  · rw [data_5269.1]; exact data_5269.2.2
  · rw [data_5269.2.1]; decide

