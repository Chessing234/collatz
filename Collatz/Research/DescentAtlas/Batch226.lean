/-- Exact parity count, endpoint, and contracting multiplier for residue 5077. -/
theorem data_5077 : oddCount 5077 14 = 5 ∧
    acceleratedOrbit 14 5077 = 76 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5077 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5077) = 243 * m + 76 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5077
  rw [data_5077.1, data_5077.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5077 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5077) < 16384 * m + 5077 := by
  apply descent_of_endpoint
  · rw [data_5077.1]; exact data_5077.2.2
  · rw [data_5077.2.1]; decide

