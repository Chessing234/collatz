/-- Exact parity count, endpoint, and contracting multiplier for residue 965. -/
theorem data_965 : oddCount 965 14 = 4 ∧
    acceleratedOrbit 14 965 = 5 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_965 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 965) = 81 * m + 5 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 965
  rw [data_965.1, data_965.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_965 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 965) < 16384 * m + 965 := by
  apply descent_of_endpoint
  · rw [data_965.1]; exact data_965.2.2
  · rw [data_965.2.1]; decide

