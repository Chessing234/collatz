/-- Exact parity count, endpoint, and contracting multiplier for residue 6665. -/
theorem data_6665 : oddCount 6665 14 = 8 ∧
    acceleratedOrbit 14 6665 = 2672 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6665 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6665) = 6561 * m + 2672 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6665
  rw [data_6665.1, data_6665.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6665 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6665) < 16384 * m + 6665 := by
  apply descent_of_endpoint
  · rw [data_6665.1]; exact data_6665.2.2
  · rw [data_6665.2.1]; decide

