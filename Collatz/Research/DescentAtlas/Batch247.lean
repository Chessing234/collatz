/-- Exact parity count, endpoint, and contracting multiplier for residue 5537. -/
theorem data_5537 : oddCount 5537 14 = 7 ∧
    acceleratedOrbit 14 5537 = 740 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5537 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5537) = 2187 * m + 740 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5537
  rw [data_5537.1, data_5537.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5537 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5537) < 16384 * m + 5537 := by
  apply descent_of_endpoint
  · rw [data_5537.1]; exact data_5537.2.2
  · rw [data_5537.2.1]; decide

