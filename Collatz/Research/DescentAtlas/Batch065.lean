/-- Exact parity count, endpoint, and contracting multiplier for residue 1449. -/
theorem data_1449 : oddCount 1449 14 = 8 ∧
    acceleratedOrbit 14 1449 = 581 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1449 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1449) = 6561 * m + 581 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1449
  rw [data_1449.1, data_1449.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1449 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1449) < 16384 * m + 1449 := by
  apply descent_of_endpoint
  · rw [data_1449.1]; exact data_1449.2.2
  · rw [data_1449.2.1]; decide

