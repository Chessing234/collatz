/-- Exact parity count, endpoint, and contracting multiplier for residue 3185. -/
theorem data_3185 : oddCount 3185 14 = 4 ∧
    acceleratedOrbit 14 3185 = 17 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3185 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3185) = 81 * m + 17 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3185
  rw [data_3185.1, data_3185.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3185 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3185) < 16384 * m + 3185 := by
  apply descent_of_endpoint
  · rw [data_3185.1]; exact data_3185.2.2
  · rw [data_3185.2.1]; decide

