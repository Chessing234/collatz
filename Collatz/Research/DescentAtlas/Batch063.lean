/-- Exact parity count, endpoint, and contracting multiplier for residue 1411. -/
theorem data_1411 : oddCount 1411 14 = 4 ∧
    acceleratedOrbit 14 1411 = 7 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1411 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1411) = 81 * m + 7 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1411
  rw [data_1411.1, data_1411.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1411 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1411) < 16384 * m + 1411 := by
  apply descent_of_endpoint
  · rw [data_1411.1]; exact data_1411.2.2
  · rw [data_1411.2.1]; decide

