/-- Exact parity count, endpoint, and contracting multiplier for residue 2855. -/
theorem data_2855 : oddCount 2855 14 = 8 ∧
    acceleratedOrbit 14 2855 = 1144 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2855 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2855) = 6561 * m + 1144 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2855
  rw [data_2855.1, data_2855.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2855 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2855) < 16384 * m + 2855 := by
  apply descent_of_endpoint
  · rw [data_2855.1]; exact data_2855.2.2
  · rw [data_2855.2.1]; decide

