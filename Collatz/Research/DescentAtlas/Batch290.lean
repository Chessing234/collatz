    acceleratedOrbit 14 6505 = 290 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6505 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6505) = 729 * m + 290 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6505
  rw [data_6505.1, data_6505.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6505 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6505) < 16384 * m + 6505 := by
  apply descent_of_endpoint
  · rw [data_6505.1]; exact data_6505.2.2
  · rw [data_6505.2.1]; decide

