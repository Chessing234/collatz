/-- Exact parity count, endpoint, and contracting multiplier for residue 4485. -/
theorem data_4485 : oddCount 4485 14 = 6 ∧
    acceleratedOrbit 14 4485 = 200 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4485 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4485) = 729 * m + 200 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4485
  rw [data_4485.1, data_4485.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4485 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4485) < 16384 * m + 4485 := by
  apply descent_of_endpoint
  · rw [data_4485.1]; exact data_4485.2.2
  · rw [data_4485.2.1]; decide

