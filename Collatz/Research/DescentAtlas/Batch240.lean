/-- Exact parity count, endpoint, and contracting multiplier for residue 5377. -/
theorem data_5377 : oddCount 5377 14 = 7 ∧
    acceleratedOrbit 14 5377 = 719 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5377 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5377) = 2187 * m + 719 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5377
  rw [data_5377.1, data_5377.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5377 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5377) < 16384 * m + 5377 := by
  apply descent_of_endpoint
  · rw [data_5377.1]; exact data_5377.2.2
  · rw [data_5377.2.1]; decide

