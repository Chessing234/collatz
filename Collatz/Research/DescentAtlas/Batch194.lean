/-- Exact parity count, endpoint, and contracting multiplier for residue 4353. -/
theorem data_4353 : oddCount 4353 14 = 6 ∧
    acceleratedOrbit 14 4353 = 194 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4353 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4353) = 729 * m + 194 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4353
  rw [data_4353.1, data_4353.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4353 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4353) < 16384 * m + 4353 := by
  apply descent_of_endpoint
  · rw [data_4353.1]; exact data_4353.2.2
  · rw [data_4353.2.1]; decide

