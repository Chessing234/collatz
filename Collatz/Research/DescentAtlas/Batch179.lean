/-- Exact parity count, endpoint, and contracting multiplier for residue 4013. -/
theorem data_4013 : oddCount 4013 14 = 8 ∧
    acceleratedOrbit 14 4013 = 1610 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4013 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4013) = 6561 * m + 1610 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4013
  rw [data_4013.1, data_4013.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4013 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4013) < 16384 * m + 4013 := by
  apply descent_of_endpoint
  · rw [data_4013.1]; exact data_4013.2.2
  · rw [data_4013.2.1]; decide

