/-- Exact parity count, endpoint, and contracting multiplier for residue 985. -/
theorem data_985 : oddCount 985 14 = 4 ∧
    acceleratedOrbit 14 985 = 5 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_985 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 985) = 81 * m + 5 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 985
  rw [data_985.1, data_985.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_985 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 985) < 16384 * m + 985 := by
  apply descent_of_endpoint
  · rw [data_985.1]; exact data_985.2.2
  · rw [data_985.2.1]; decide

