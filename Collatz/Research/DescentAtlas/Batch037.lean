/-- Exact parity count, endpoint, and contracting multiplier for residue 829. -/
theorem data_829 : oddCount 829 14 = 8 ∧
    acceleratedOrbit 14 829 = 334 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_829 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 829) = 6561 * m + 334 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 829
  rw [data_829.1, data_829.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_829 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 829) < 16384 * m + 829 := by
  apply descent_of_endpoint
  · rw [data_829.1]; exact data_829.2.2
  · rw [data_829.2.1]; decide

