/-- Exact parity count, endpoint, and contracting multiplier for residue 6725. -/
theorem data_6725 : oddCount 6725 14 = 5 ∧
    acceleratedOrbit 14 6725 = 100 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6725 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6725) = 243 * m + 100 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6725
  rw [data_6725.1, data_6725.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6725 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6725) < 16384 * m + 6725 := by
  apply descent_of_endpoint
  · rw [data_6725.1]; exact data_6725.2.2
  · rw [data_6725.2.1]; decide

