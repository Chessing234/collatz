/-- Exact parity count, endpoint, and contracting multiplier for residue 945. -/
theorem data_945 : oddCount 945 14 = 6 ∧
    acceleratedOrbit 14 945 = 44 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_945 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 945) = 729 * m + 44 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 945
  rw [data_945.1, data_945.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_945 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 945) < 16384 * m + 945 := by
  apply descent_of_endpoint
  · rw [data_945.1]; exact data_945.2.2
  · rw [data_945.2.1]; decide

