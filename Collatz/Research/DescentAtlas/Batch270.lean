/-- Exact parity count, endpoint, and contracting multiplier for residue 6049. -/
theorem data_6049 : oddCount 6049 14 = 7 ∧
    acceleratedOrbit 14 6049 = 809 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6049 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6049) = 2187 * m + 809 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6049
  rw [data_6049.1, data_6049.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6049 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6049) < 16384 * m + 6049 := by
  apply descent_of_endpoint
  · rw [data_6049.1]; exact data_6049.2.2
  · rw [data_6049.2.1]; decide

