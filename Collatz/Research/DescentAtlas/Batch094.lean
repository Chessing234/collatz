/-- Exact parity count, endpoint, and contracting multiplier for residue 2101. -/
theorem data_2101 : oddCount 2101 14 = 4 ∧
    acceleratedOrbit 14 2101 = 11 ∧ 81 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2101 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2101) = 81 * m + 11 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2101
  rw [data_2101.1, data_2101.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2101 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2101) < 16384 * m + 2101 := by
  apply descent_of_endpoint
  · rw [data_2101.1]; exact data_2101.2.2
  · rw [data_2101.2.1]; decide

