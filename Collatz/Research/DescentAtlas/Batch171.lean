/-- Exact parity count, endpoint, and contracting multiplier for residue 3851. -/
theorem data_3851 : oddCount 3851 14 = 7 ∧
    acceleratedOrbit 14 3851 = 515 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3851 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3851) = 2187 * m + 515 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3851
  rw [data_3851.1, data_3851.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3851 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3851) < 16384 * m + 3851 := by
  apply descent_of_endpoint
  · rw [data_3851.1]; exact data_3851.2.2
  · rw [data_3851.2.1]; decide

