/-- Exact parity count, endpoint, and contracting multiplier for residue 3251. -/
theorem data_3251 : oddCount 3251 14 = 6 ∧
    acceleratedOrbit 14 3251 = 145 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3251 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3251) = 729 * m + 145 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3251
  rw [data_3251.1, data_3251.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3251 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3251) < 16384 * m + 3251 := by
  apply descent_of_endpoint
  · rw [data_3251.1]; exact data_3251.2.2
  · rw [data_3251.2.1]; decide

