/-- Exact parity count, endpoint, and contracting multiplier for residue 5635. -/
theorem data_5635 : oddCount 5635 14 = 7 ∧
    acceleratedOrbit 14 5635 = 755 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5635 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5635) = 2187 * m + 755 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5635
  rw [data_5635.1, data_5635.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5635 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5635) < 16384 * m + 5635 := by
  apply descent_of_endpoint
  · rw [data_5635.1]; exact data_5635.2.2
  · rw [data_5635.2.1]; decide

