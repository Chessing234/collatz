/-- Exact parity count, endpoint, and contracting multiplier for residue 3029. -/
theorem data_3029 : oddCount 3029 14 = 6 ∧
    acceleratedOrbit 14 3029 = 137 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3029 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3029) = 729 * m + 137 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3029
  rw [data_3029.1, data_3029.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3029 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3029) < 16384 * m + 3029 := by
  apply descent_of_endpoint
  · rw [data_3029.1]; exact data_3029.2.2
  · rw [data_3029.2.1]; decide

