/-- Exact parity count, endpoint, and contracting multiplier for residue 6323. -/
theorem data_6323 : oddCount 6323 14 = 8 ∧
    acceleratedOrbit 14 6323 = 2537 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6323 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6323) = 6561 * m + 2537 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6323
  rw [data_6323.1, data_6323.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6323 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6323) < 16384 * m + 6323 := by
  apply descent_of_endpoint
  · rw [data_6323.1]; exact data_6323.2.2
  · rw [data_6323.2.1]; decide

