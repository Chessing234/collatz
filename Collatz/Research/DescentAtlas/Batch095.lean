/-- Exact parity count, endpoint, and contracting multiplier for residue 2127. -/
theorem data_2127 : oddCount 2127 14 = 8 ∧
    acceleratedOrbit 14 2127 = 854 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2127 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2127) = 6561 * m + 854 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2127
  rw [data_2127.1, data_2127.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2127 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2127) < 16384 * m + 2127 := by
  apply descent_of_endpoint
  · rw [data_2127.1]; exact data_2127.2.2
  · rw [data_2127.2.1]; decide

