/-- Exact parity count, endpoint, and contracting multiplier for residue 507. -/
theorem data_507 : oddCount 507 14 = 7 ∧
    acceleratedOrbit 14 507 = 68 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_507 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 507) = 2187 * m + 68 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 507
  rw [data_507.1, data_507.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_507 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 507) < 16384 * m + 507 := by
  apply descent_of_endpoint
  · rw [data_507.1]; exact data_507.2.2
  · rw [data_507.2.1]; decide

