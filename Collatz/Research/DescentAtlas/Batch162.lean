/-- Exact parity count, endpoint, and contracting multiplier for residue 3641. -/
theorem data_3641 : oddCount 3641 14 = 8 ∧
    acceleratedOrbit 14 3641 = 1460 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3641 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3641) = 6561 * m + 1460 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3641
  rw [data_3641.1, data_3641.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3641 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3641) < 16384 * m + 3641 := by
  apply descent_of_endpoint
  · rw [data_3641.1]; exact data_3641.2.2
  · rw [data_3641.2.1]; decide

