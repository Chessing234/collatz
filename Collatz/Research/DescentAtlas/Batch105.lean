/-- Exact parity count, endpoint, and contracting multiplier for residue 2355. -/
theorem data_2355 : oddCount 2355 14 = 5 ∧
    acceleratedOrbit 14 2355 = 35 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2355 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2355) = 243 * m + 35 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2355
  rw [data_2355.1, data_2355.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2355 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2355) < 16384 * m + 2355 := by
  apply descent_of_endpoint
  · rw [data_2355.1]; exact data_2355.2.2
  · rw [data_2355.2.1]; decide

