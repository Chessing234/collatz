/-- Exact parity count, endpoint, and contracting multiplier for residue 3869. -/
theorem data_3869 : oddCount 3869 14 = 8 ∧
    acceleratedOrbit 14 3869 = 1552 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3869 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3869) = 6561 * m + 1552 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3869
  rw [data_3869.1, data_3869.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3869 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3869) < 16384 * m + 3869 := by
  apply descent_of_endpoint
  · rw [data_3869.1]; exact data_3869.2.2
  · rw [data_3869.2.1]; decide

