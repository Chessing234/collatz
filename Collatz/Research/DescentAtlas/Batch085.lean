import Collatz.Research.DescentAtlas.Core

/-! Batch 85: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch085
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 1891. -/
theorem data_1891 : oddCount 1891 14 = 5 ∧
    acceleratedOrbit 14 1891 = 29 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1891 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1891) = 243 * m + 29 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1891
  rw [data_1891.1, data_1891.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1891 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1891) < 16384 * m + 1891 := by
  apply descent_of_endpoint
  · rw [data_1891.1]; exact data_1891.2.2
  · rw [data_1891.2.1]; decide

