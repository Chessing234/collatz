/-- Exact parity count, endpoint, and contracting multiplier for residue 4161. -/
theorem data_4161 : oddCount 4161 14 = 7 ∧
    acceleratedOrbit 14 4161 = 557 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4161 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4161) = 2187 * m + 557 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4161
  rw [data_4161.1, data_4161.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4161 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4161) < 16384 * m + 4161 := by
  apply descent_of_endpoint
  · rw [data_4161.1]; exact data_4161.2.2
  · rw [data_4161.2.1]; decide

