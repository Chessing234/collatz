/-- Exact parity count, endpoint, and contracting multiplier for residue 4601. -/
theorem data_4601 : oddCount 4601 14 = 8 ∧
    acceleratedOrbit 14 4601 = 1844 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4601 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4601) = 6561 * m + 1844 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4601
  rw [data_4601.1, data_4601.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4601 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4601) < 16384 * m + 4601 := by
  apply descent_of_endpoint
  · rw [data_4601.1]; exact data_4601.2.2
  · rw [data_4601.2.1]; decide

