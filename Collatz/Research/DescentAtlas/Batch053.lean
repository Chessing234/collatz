/-- Exact parity count, endpoint, and contracting multiplier for residue 1187. -/
theorem data_1187 : oddCount 1187 14 = 8 ∧
    acceleratedOrbit 14 1187 = 479 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1187 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1187) = 6561 * m + 479 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1187
  rw [data_1187.1, data_1187.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1187 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1187) < 16384 * m + 1187 := by
  apply descent_of_endpoint
  · rw [data_1187.1]; exact data_1187.2.2
  · rw [data_1187.2.1]; decide

