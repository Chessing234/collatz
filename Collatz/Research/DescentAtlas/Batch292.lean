/-- Exact parity count, endpoint, and contracting multiplier for residue 6543. -/
theorem data_6543 : oddCount 6543 14 = 7 ∧
    acceleratedOrbit 14 6543 = 874 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6543 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6543) = 2187 * m + 874 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6543
  rw [data_6543.1, data_6543.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6543 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6543) < 16384 * m + 6543 := by
  apply descent_of_endpoint
  · rw [data_6543.1]; exact data_6543.2.2
  · rw [data_6543.2.1]; decide

