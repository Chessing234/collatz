/-- Exact parity count, endpoint, and contracting multiplier for residue 4917. -/
theorem data_4917 : oddCount 4917 14 = 5 ∧
    acceleratedOrbit 14 4917 = 74 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4917 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4917) = 243 * m + 74 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4917
  rw [data_4917.1, data_4917.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4917 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4917) < 16384 * m + 4917 := by
  apply descent_of_endpoint
  · rw [data_4917.1]; exact data_4917.2.2
  · rw [data_4917.2.1]; decide

