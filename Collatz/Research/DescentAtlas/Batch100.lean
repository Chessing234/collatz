/-- Exact parity count, endpoint, and contracting multiplier for residue 2249. -/
theorem data_2249 : oddCount 2249 14 = 6 ∧
    acceleratedOrbit 14 2249 = 101 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2249 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2249) = 729 * m + 101 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2249
  rw [data_2249.1, data_2249.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2249 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2249) < 16384 * m + 2249 := by
  apply descent_of_endpoint
  · rw [data_2249.1]; exact data_2249.2.2
  · rw [data_2249.2.1]; decide

