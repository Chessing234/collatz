/-- Exact parity count, endpoint, and contracting multiplier for residue 651. -/
theorem data_651 : oddCount 651 14 = 8 ∧
    acceleratedOrbit 14 651 = 263 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_651 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 651) = 6561 * m + 263 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 651
  rw [data_651.1, data_651.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_651 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 651) < 16384 * m + 651 := by
  apply descent_of_endpoint
  · rw [data_651.1]; exact data_651.2.2
  · rw [data_651.2.1]; decide

