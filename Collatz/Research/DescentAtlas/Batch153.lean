/-- Exact parity count, endpoint, and contracting multiplier for residue 3437. -/
theorem data_3437 : oddCount 3437 14 = 8 ∧
    acceleratedOrbit 14 3437 = 1379 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3437 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3437) = 6561 * m + 1379 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3437
  rw [data_3437.1, data_3437.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3437 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3437) < 16384 * m + 3437 := by
  apply descent_of_endpoint
  · rw [data_3437.1]; exact data_3437.2.2
  · rw [data_3437.2.1]; decide

