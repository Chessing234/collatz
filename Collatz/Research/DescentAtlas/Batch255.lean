/-- Exact parity count, endpoint, and contracting multiplier for residue 5719. -/
theorem data_5719 : oddCount 5719 14 = 8 ∧
    acceleratedOrbit 14 5719 = 2294 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5719 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5719) = 6561 * m + 2294 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5719
  rw [data_5719.1, data_5719.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5719 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5719) < 16384 * m + 5719 := by
  apply descent_of_endpoint
  · rw [data_5719.1]; exact data_5719.2.2
  · rw [data_5719.2.1]; decide

