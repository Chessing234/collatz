/-- Exact parity count, endpoint, and contracting multiplier for residue 4823. -/
theorem data_4823 : oddCount 4823 14 = 8 ∧
    acceleratedOrbit 14 4823 = 1934 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4823 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4823) = 6561 * m + 1934 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4823
  rw [data_4823.1, data_4823.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4823 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4823) < 16384 * m + 4823 := by
  apply descent_of_endpoint
  · rw [data_4823.1]; exact data_4823.2.2
  · rw [data_4823.2.1]; decide

