/-- Exact parity count, endpoint, and contracting multiplier for residue 1369. -/
theorem data_1369 : oddCount 1369 14 = 7 ∧
    acceleratedOrbit 14 1369 = 184 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1369 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1369) = 2187 * m + 184 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1369
  rw [data_1369.1, data_1369.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1369 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1369) < 16384 * m + 1369 := by
  apply descent_of_endpoint
  · rw [data_1369.1]; exact data_1369.2.2
  · rw [data_1369.2.1]; decide

