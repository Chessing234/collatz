/-- Exact parity count, endpoint, and contracting multiplier for residue 2509. -/
theorem data_2509 : oddCount 2509 14 = 7 ∧
    acceleratedOrbit 14 2509 = 337 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2509 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2509) = 2187 * m + 337 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2509
  rw [data_2509.1, data_2509.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2509 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2509) < 16384 * m + 2509 := by
  apply descent_of_endpoint
  · rw [data_2509.1]; exact data_2509.2.2
  · rw [data_2509.2.1]; decide

