/-- Exact parity count, endpoint, and contracting multiplier for residue 5653. -/
theorem data_5653 : oddCount 5653 14 = 6 ∧
    acceleratedOrbit 14 5653 = 253 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5653 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5653) = 729 * m + 253 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5653
  rw [data_5653.1, data_5653.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5653 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5653) < 16384 * m + 5653 := by
  apply descent_of_endpoint
  · rw [data_5653.1]; exact data_5653.2.2
  · rw [data_5653.2.1]; decide

