/-- Exact parity count, endpoint, and contracting multiplier for residue 877. -/
theorem data_877 : oddCount 877 14 = 7 ∧
    acceleratedOrbit 14 877 = 118 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_877 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 877) = 2187 * m + 118 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 877
  rw [data_877.1, data_877.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_877 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 877) < 16384 * m + 877 := by
  apply descent_of_endpoint
  · rw [data_877.1]; exact data_877.2.2
  · rw [data_877.2.1]; decide

