/-- Exact parity count, endpoint, and contracting multiplier for residue 1217. -/
theorem data_1217 : oddCount 1217 14 = 7 ∧
    acceleratedOrbit 14 1217 = 164 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1217 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1217) = 2187 * m + 164 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1217
  rw [data_1217.1, data_1217.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1217 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1217) < 16384 * m + 1217 := by
  apply descent_of_endpoint
  · rw [data_1217.1]; exact data_1217.2.2
  · rw [data_1217.2.1]; decide

