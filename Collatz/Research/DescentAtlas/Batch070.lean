/-- Exact parity count, endpoint, and contracting multiplier for residue 1559. -/
theorem data_1559 : oddCount 1559 14 = 7 ∧
    acceleratedOrbit 14 1559 = 209 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1559 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1559) = 2187 * m + 209 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1559
  rw [data_1559.1, data_1559.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1559 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1559) < 16384 * m + 1559 := by
  apply descent_of_endpoint
  · rw [data_1559.1]; exact data_1559.2.2
  · rw [data_1559.2.1]; decide

