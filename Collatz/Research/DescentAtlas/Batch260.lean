/-- Exact parity count, endpoint, and contracting multiplier for residue 5835. -/
theorem data_5835 : oddCount 5835 14 = 8 ∧
    acceleratedOrbit 14 5835 = 2339 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5835 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5835) = 6561 * m + 2339 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5835
  rw [data_5835.1, data_5835.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5835 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5835) < 16384 * m + 5835 := by
  apply descent_of_endpoint
  · rw [data_5835.1]; exact data_5835.2.2
  · rw [data_5835.2.1]; decide

