/-- Exact parity count, endpoint, and contracting multiplier for residue 5181. -/
theorem data_5181 : oddCount 5181 14 = 5 ∧
    acceleratedOrbit 14 5181 = 77 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5181 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5181) = 243 * m + 77 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5181
  rw [data_5181.1, data_5181.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5181 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5181) < 16384 * m + 5181 := by
  apply descent_of_endpoint
  · rw [data_5181.1]; exact data_5181.2.2
  · rw [data_5181.2.1]; decide

