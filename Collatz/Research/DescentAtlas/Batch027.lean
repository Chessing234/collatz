/-- Exact parity count, endpoint, and contracting multiplier for residue 613. -/
theorem data_613 : oddCount 613 14 = 6 ∧
    acceleratedOrbit 14 613 = 28 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_613 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 613) = 729 * m + 28 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 613
  rw [data_613.1, data_613.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_613 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 613) < 16384 * m + 613 := by
  apply descent_of_endpoint
  · rw [data_613.1]; exact data_613.2.2
  · rw [data_613.2.1]; decide

