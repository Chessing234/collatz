/-- Exact parity count, endpoint, and contracting multiplier for residue 3905. -/
theorem data_3905 : oddCount 3905 14 = 6 ∧
    acceleratedOrbit 14 3905 = 175 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3905 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3905) = 729 * m + 175 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3905
  rw [data_3905.1, data_3905.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3905 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3905) < 16384 * m + 3905 := by
  apply descent_of_endpoint
  · rw [data_3905.1]; exact data_3905.2.2
  · rw [data_3905.2.1]; decide

