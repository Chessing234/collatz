/-- Exact parity count, endpoint, and contracting multiplier for residue 787. -/
theorem data_787 : oddCount 787 14 = 8 ∧
    acceleratedOrbit 14 787 = 317 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_787 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 787) = 6561 * m + 317 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 787
  rw [data_787.1, data_787.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_787 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 787) < 16384 * m + 787 := by
  apply descent_of_endpoint
  · rw [data_787.1]; exact data_787.2.2
  · rw [data_787.2.1]; decide

