/-- Exact parity count, endpoint, and contracting multiplier for residue 2737. -/
theorem data_2737 : oddCount 2737 14 = 7 ∧
    acceleratedOrbit 14 2737 = 368 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2737 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2737) = 2187 * m + 368 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2737
  rw [data_2737.1, data_2737.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2737 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2737) < 16384 * m + 2737 := by
  apply descent_of_endpoint
  · rw [data_2737.1]; exact data_2737.2.2
  · rw [data_2737.2.1]; decide

