/-- Exact parity count, endpoint, and contracting multiplier for residue 5499. -/
theorem data_5499 : oddCount 5499 14 = 8 ∧
    acceleratedOrbit 14 5499 = 2204 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5499 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5499) = 6561 * m + 2204 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5499
  rw [data_5499.1, data_5499.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5499 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5499) < 16384 * m + 5499 := by
  apply descent_of_endpoint
  · rw [data_5499.1]; exact data_5499.2.2
  · rw [data_5499.2.1]; decide

