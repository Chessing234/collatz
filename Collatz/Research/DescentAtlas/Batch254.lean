/-- Exact parity count, endpoint, and contracting multiplier for residue 5701. -/
theorem data_5701 : oddCount 5701 14 = 5 ∧
    acceleratedOrbit 14 5701 = 85 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5701 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5701) = 243 * m + 85 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5701
  rw [data_5701.1, data_5701.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5701 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5701) < 16384 * m + 5701 := by
  apply descent_of_endpoint
  · rw [data_5701.1]; exact data_5701.2.2
  · rw [data_5701.2.1]; decide

