/-- Exact parity count, endpoint, and contracting multiplier for residue 5881. -/
theorem data_5881 : oddCount 5881 14 = 6 ∧
    acceleratedOrbit 14 5881 = 262 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5881 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5881) = 729 * m + 262 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5881
  rw [data_5881.1, data_5881.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5881 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5881) < 16384 * m + 5881 := by
  apply descent_of_endpoint
  · rw [data_5881.1]; exact data_5881.2.2
  · rw [data_5881.2.1]; decide

