/-- Exact parity count, endpoint, and contracting multiplier for residue 1135. -/
theorem data_1135 : oddCount 1135 14 = 8 ∧
    acceleratedOrbit 14 1135 = 455 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1135 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1135) = 6561 * m + 455 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1135
  rw [data_1135.1, data_1135.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1135 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1135) < 16384 * m + 1135 := by
  apply descent_of_endpoint
  · rw [data_1135.1]; exact data_1135.2.2
  · rw [data_1135.2.1]; decide

