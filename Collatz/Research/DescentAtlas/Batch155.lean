/-- Exact parity count, endpoint, and contracting multiplier for residue 3469. -/
theorem data_3469 : oddCount 3469 14 = 5 ∧
    acceleratedOrbit 14 3469 = 53 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3469 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3469) = 243 * m + 53 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3469
  rw [data_3469.1, data_3469.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3469 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3469) < 16384 * m + 3469 := by
  apply descent_of_endpoint
  · rw [data_3469.1]; exact data_3469.2.2
  · rw [data_3469.2.1]; decide

