import Collatz.Research.DescentAtlas.Core

/-! Batch 11: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch011
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 253. -/
theorem data_253 : oddCount 253 14 = 8 ∧
    acceleratedOrbit 14 253 = 103 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_253 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 253) = 6561 * m + 103 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 253
  rw [data_253.1, data_253.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_253 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 253) < 16384 * m + 253 := by
  apply descent_of_endpoint
  · rw [data_253.1]; exact data_253.2.2
  · rw [data_253.2.1]; decide

