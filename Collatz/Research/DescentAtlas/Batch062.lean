/-- Exact parity count, endpoint, and contracting multiplier for residue 1387. -/
theorem data_1387 : oddCount 1387 14 = 8 ∧
    acceleratedOrbit 14 1387 = 557 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1387 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1387) = 6561 * m + 557 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1387
  rw [data_1387.1, data_1387.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1387 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1387) < 16384 * m + 1387 := by
  apply descent_of_endpoint
  · rw [data_1387.1]; exact data_1387.2.2
  · rw [data_1387.2.1]; decide

