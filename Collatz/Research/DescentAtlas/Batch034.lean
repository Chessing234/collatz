/-- Exact parity count, endpoint, and contracting multiplier for residue 769. -/
theorem data_769 : oddCount 769 14 = 6 ∧
    acceleratedOrbit 14 769 = 35 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_769 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 769) = 729 * m + 35 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 769
  rw [data_769.1, data_769.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_769 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 769) < 16384 * m + 769 := by
  apply descent_of_endpoint
  · rw [data_769.1]; exact data_769.2.2
  · rw [data_769.2.1]; decide

