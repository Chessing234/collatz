/-- Exact parity count, endpoint, and contracting multiplier for residue 6583. -/
theorem data_6583 : oddCount 6583 14 = 6 ∧
    acceleratedOrbit 14 6583 = 293 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6583 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6583) = 729 * m + 293 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6583
  rw [data_6583.1, data_6583.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6583 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6583) < 16384 * m + 6583 := by
  apply descent_of_endpoint
  · rw [data_6583.1]; exact data_6583.2.2
  · rw [data_6583.2.1]; decide

