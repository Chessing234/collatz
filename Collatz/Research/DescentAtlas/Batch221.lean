/-- Exact parity count, endpoint, and contracting multiplier for residue 4957. -/
theorem data_4957 : oddCount 4957 14 = 6 ∧
    acceleratedOrbit 14 4957 = 221 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4957 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4957) = 729 * m + 221 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4957
  rw [data_4957.1, data_4957.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4957 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4957) < 16384 * m + 4957 := by
  apply descent_of_endpoint
  · rw [data_4957.1]; exact data_4957.2.2
  · rw [data_4957.2.1]; decide

