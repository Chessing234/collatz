/-- Exact parity count, endpoint, and contracting multiplier for residue 2529. -/
theorem data_2529 : oddCount 2529 14 = 7 ∧
    acceleratedOrbit 14 2529 = 338 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2529 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2529) = 2187 * m + 338 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2529
  rw [data_2529.1, data_2529.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2529 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2529) < 16384 * m + 2529 := by
  apply descent_of_endpoint
  · rw [data_2529.1]; exact data_2529.2.2
  · rw [data_2529.2.1]; decide

