/-- Exact parity count, endpoint, and contracting multiplier for residue 5607. -/
theorem data_5607 : oddCount 5607 14 = 8 ∧
    acceleratedOrbit 14 5607 = 2246 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5607 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5607) = 6561 * m + 2246 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5607
  rw [data_5607.1, data_5607.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5607 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5607) < 16384 * m + 5607 := by
  apply descent_of_endpoint
  · rw [data_5607.1]; exact data_5607.2.2
  · rw [data_5607.2.1]; decide

