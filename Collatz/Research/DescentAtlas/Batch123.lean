/-- Exact parity count, endpoint, and contracting multiplier for residue 2755. -/
theorem data_2755 : oddCount 2755 14 = 8 ∧
    acceleratedOrbit 14 2755 = 1106 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2755 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2755) = 6561 * m + 1106 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2755
  rw [data_2755.1, data_2755.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2755 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2755) < 16384 * m + 2755 := by
  apply descent_of_endpoint
  · rw [data_2755.1]; exact data_2755.2.2
  · rw [data_2755.2.1]; decide

