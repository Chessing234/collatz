/-- Exact parity count, endpoint, and contracting multiplier for residue 2201. -/
theorem data_2201 : oddCount 2201 14 = 8 ∧
    acceleratedOrbit 14 2201 = 884 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2201 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2201) = 6561 * m + 884 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2201
  rw [data_2201.1, data_2201.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2201 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2201) < 16384 * m + 2201 := by
  apply descent_of_endpoint
  · rw [data_2201.1]; exact data_2201.2.2
  · rw [data_2201.2.1]; decide

