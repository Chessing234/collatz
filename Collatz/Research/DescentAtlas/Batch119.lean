/-- Exact parity count, endpoint, and contracting multiplier for residue 2663. -/
theorem data_2663 : oddCount 2663 14 = 8 ∧
    acceleratedOrbit 14 2663 = 1067 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2663 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2663) = 6561 * m + 1067 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2663
  rw [data_2663.1, data_2663.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2663 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2663) < 16384 * m + 2663 := by
  apply descent_of_endpoint
  · rw [data_2663.1]; exact data_2663.2.2
  · rw [data_2663.2.1]; decide

