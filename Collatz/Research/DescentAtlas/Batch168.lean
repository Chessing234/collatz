    acceleratedOrbit 14 3773 = 56 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3773 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3773) = 243 * m + 56 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3773
  rw [data_3773.1, data_3773.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3773 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3773) < 16384 * m + 3773 := by
  apply descent_of_endpoint
  · rw [data_3773.1]; exact data_3773.2.2
  · rw [data_3773.2.1]; decide

