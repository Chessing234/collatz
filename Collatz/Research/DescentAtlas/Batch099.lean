/-- Exact parity count, endpoint, and contracting multiplier for residue 2229. -/
theorem data_2229 : oddCount 2229 14 = 6 ∧
    acceleratedOrbit 14 2229 = 101 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2229 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2229) = 729 * m + 101 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2229
  rw [data_2229.1, data_2229.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2229 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2229) < 16384 * m + 2229 := by
  apply descent_of_endpoint
  · rw [data_2229.1]; exact data_2229.2.2
  · rw [data_2229.2.1]; decide

