/-- Exact parity count, endpoint, and contracting multiplier for residue 3341. -/
theorem data_3341 : oddCount 3341 14 = 7 ∧
    acceleratedOrbit 14 3341 = 449 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3341 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3341) = 2187 * m + 449 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3341
  rw [data_3341.1, data_3341.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3341 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3341) < 16384 * m + 3341 := by
  apply descent_of_endpoint
  · rw [data_3341.1]; exact data_3341.2.2
  · rw [data_3341.2.1]; decide

