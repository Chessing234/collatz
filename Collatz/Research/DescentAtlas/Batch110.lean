/-- Exact parity count, endpoint, and contracting multiplier for residue 2467. -/
theorem data_2467 : oddCount 2467 14 = 8 ∧
    acceleratedOrbit 14 2467 = 992 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2467 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2467) = 6561 * m + 992 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2467
  rw [data_2467.1, data_2467.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2467 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2467) < 16384 * m + 2467 := by
  apply descent_of_endpoint
  · rw [data_2467.1]; exact data_2467.2.2
  · rw [data_2467.2.1]; decide

