/-- Exact parity count, endpoint, and contracting multiplier for residue 347. -/
theorem data_347 : oddCount 347 14 = 7 ∧
    acceleratedOrbit 14 347 = 47 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_347 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 347) = 2187 * m + 47 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 347
  rw [data_347.1, data_347.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_347 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 347) < 16384 * m + 347 := by
  apply descent_of_endpoint
  · rw [data_347.1]; exact data_347.2.2
  · rw [data_347.2.1]; decide

