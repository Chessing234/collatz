/-- Exact parity count, endpoint, and contracting multiplier for residue 6145. -/
theorem data_6145 : oddCount 6145 14 = 7 ∧
    acceleratedOrbit 14 6145 = 821 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6145 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6145) = 2187 * m + 821 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6145
  rw [data_6145.1, data_6145.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6145 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6145) < 16384 * m + 6145 := by
  apply descent_of_endpoint
  · rw [data_6145.1]; exact data_6145.2.2
  · rw [data_6145.2.1]; decide

