/-- Exact parity count, endpoint, and contracting multiplier for residue 2485. -/
theorem data_2485 : oddCount 2485 14 = 7 ∧
    acceleratedOrbit 14 2485 = 334 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2485 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2485) = 2187 * m + 334 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2485
  rw [data_2485.1, data_2485.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2485 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2485) < 16384 * m + 2485 := by
  apply descent_of_endpoint
  · rw [data_2485.1]; exact data_2485.2.2
  · rw [data_2485.2.1]; decide

