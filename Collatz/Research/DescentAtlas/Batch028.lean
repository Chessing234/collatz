/-- Exact parity count, endpoint, and contracting multiplier for residue 629. -/
theorem data_629 : oddCount 629 14 = 6 ∧
    acceleratedOrbit 14 629 = 29 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_629 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 629) = 729 * m + 29 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 629
  rw [data_629.1, data_629.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_629 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 629) < 16384 * m + 629 := by
  apply descent_of_endpoint
  · rw [data_629.1]; exact data_629.2.2
  · rw [data_629.2.1]; decide

