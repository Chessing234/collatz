/-- Exact parity count, endpoint, and contracting multiplier for residue 5853. -/
theorem data_5853 : oddCount 5853 14 = 8 ∧
    acceleratedOrbit 14 5853 = 2348 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5853 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5853) = 6561 * m + 2348 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5853
  rw [data_5853.1, data_5853.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5853 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5853) < 16384 * m + 5853 := by
  apply descent_of_endpoint
  · rw [data_5853.1]; exact data_5853.2.2
  · rw [data_5853.2.1]; decide

