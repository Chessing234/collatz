/-- Exact parity count, endpoint, and contracting multiplier for residue 1345. -/
theorem data_1345 : oddCount 1345 14 = 7 ∧
    acceleratedOrbit 14 1345 = 182 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1345 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1345) = 2187 * m + 182 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1345
  rw [data_1345.1, data_1345.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1345 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1345) < 16384 * m + 1345 := by
  apply descent_of_endpoint
  · rw [data_1345.1]; exact data_1345.2.2
  · rw [data_1345.2.1]; decide

