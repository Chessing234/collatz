/-- Exact parity count, endpoint, and contracting multiplier for residue 6253. -/
theorem data_6253 : oddCount 6253 14 = 8 ∧
    acceleratedOrbit 14 6253 = 2506 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6253 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6253) = 6561 * m + 2506 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6253
  rw [data_6253.1, data_6253.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6253 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6253) < 16384 * m + 6253 := by
  apply descent_of_endpoint
  · rw [data_6253.1]; exact data_6253.2.2
  · rw [data_6253.2.1]; decide

