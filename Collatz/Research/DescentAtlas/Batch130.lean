/-- Exact parity count, endpoint, and contracting multiplier for residue 2915. -/
theorem data_2915 : oddCount 2915 14 = 5 ∧
    acceleratedOrbit 14 2915 = 44 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2915 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2915) = 243 * m + 44 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2915
  rw [data_2915.1, data_2915.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2915 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2915) < 16384 * m + 2915 := by
  apply descent_of_endpoint
  · rw [data_2915.1]; exact data_2915.2.2
  · rw [data_2915.2.1]; decide

