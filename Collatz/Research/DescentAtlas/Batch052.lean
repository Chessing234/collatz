/-- Exact parity count, endpoint, and contracting multiplier for residue 1165. -/
theorem data_1165 : oddCount 1165 14 = 7 ∧
    acceleratedOrbit 14 1165 = 161 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1165 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1165) = 2187 * m + 161 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1165
  rw [data_1165.1, data_1165.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1165 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1165) < 16384 * m + 1165 := by
  apply descent_of_endpoint
  · rw [data_1165.1]; exact data_1165.2.2
  · rw [data_1165.2.1]; decide

