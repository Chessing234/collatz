/-- Exact parity count, endpoint, and contracting multiplier for residue 2707. -/
theorem data_2707 : oddCount 2707 14 = 7 ∧
    acceleratedOrbit 14 2707 = 362 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2707 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2707) = 2187 * m + 362 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2707
  rw [data_2707.1, data_2707.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2707 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2707) < 16384 * m + 2707 := by
  apply descent_of_endpoint
  · rw [data_2707.1]; exact data_2707.2.2
  · rw [data_2707.2.1]; decide

