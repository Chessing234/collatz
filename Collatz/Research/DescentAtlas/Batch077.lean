/-- Exact parity count, endpoint, and contracting multiplier for residue 1709. -/
theorem data_1709 : oddCount 1709 14 = 8 ∧
    acceleratedOrbit 14 1709 = 688 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_1709 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1709) = 6561 * m + 688 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 1709
  rw [data_1709.1, data_1709.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_1709 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 1709) < 16384 * m + 1709 := by
  apply descent_of_endpoint
  · rw [data_1709.1]; exact data_1709.2.2
  · rw [data_1709.2.1]; decide

