/-- Exact parity count, endpoint, and contracting multiplier for residue 2935. -/
theorem data_2935 : oddCount 2935 14 = 8 ∧
    acceleratedOrbit 14 2935 = 1178 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2935 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2935) = 6561 * m + 1178 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2935
  rw [data_2935.1, data_2935.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2935 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2935) < 16384 * m + 2935 := by
  apply descent_of_endpoint
  · rw [data_2935.1]; exact data_2935.2.2
  · rw [data_2935.2.1]; decide

