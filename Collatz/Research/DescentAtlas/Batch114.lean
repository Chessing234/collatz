/-- Exact parity count, endpoint, and contracting multiplier for residue 2563. -/
theorem data_2563 : oddCount 2563 14 = 7 ∧
    acceleratedOrbit 14 2563 = 344 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2563 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2563) = 2187 * m + 344 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2563
  rw [data_2563.1, data_2563.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2563 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2563) < 16384 * m + 2563 := by
  apply descent_of_endpoint
  · rw [data_2563.1]; exact data_2563.2.2
  · rw [data_2563.2.1]; decide

