/-- Exact parity count, endpoint, and contracting multiplier for residue 4805. -/
theorem data_4805 : oddCount 4805 14 = 7 ∧
    acceleratedOrbit 14 4805 = 647 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4805 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4805) = 2187 * m + 647 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4805
  rw [data_4805.1, data_4805.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4805 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4805) < 16384 * m + 4805 := by
  apply descent_of_endpoint
  · rw [data_4805.1]; exact data_4805.2.2
  · rw [data_4805.2.1]; decide

