/-- Exact parity count, endpoint, and contracting multiplier for residue 4055. -/
theorem data_4055 : oddCount 4055 14 = 8 ∧
    acceleratedOrbit 14 4055 = 1625 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4055 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4055) = 6561 * m + 1625 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4055
  rw [data_4055.1, data_4055.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4055 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4055) < 16384 * m + 4055 := by
  apply descent_of_endpoint
  · rw [data_4055.1]; exact data_4055.2.2
  · rw [data_4055.2.1]; decide

