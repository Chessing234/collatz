/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5903 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5903) < 16384 * m + 5903 := by
  apply descent_of_endpoint
  · rw [data_5903.1]; exact data_5903.2.2
  · rw [data_5903.2.1]; decide

