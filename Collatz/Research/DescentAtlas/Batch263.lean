    acceleratedOrbit 14 5903 = 263 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5903 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5903) = 729 * m + 263 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5903
