/-- Exact parity count, endpoint, and contracting multiplier for residue 6297. -/
theorem data_6297 : oddCount 6297 14 = 8 ∧
    acceleratedOrbit 14 6297 = 2524 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6297 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6297) = 6561 * m + 2524 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6297
  rw [data_6297.1, data_6297.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6297 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6297) < 16384 * m + 6297 := by
  apply descent_of_endpoint
  · rw [data_6297.1]; exact data_6297.2.2
  · rw [data_6297.2.1]; decide

