/-- Exact parity count, endpoint, and contracting multiplier for residue 2149. -/
theorem data_2149 : oddCount 2149 14 = 5 ∧
    acceleratedOrbit 14 2149 = 32 ∧ 243 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2149 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2149) = 243 * m + 32 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2149
  rw [data_2149.1, data_2149.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2149 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2149) < 16384 * m + 2149 := by
  apply descent_of_endpoint
  · rw [data_2149.1]; exact data_2149.2.2
  · rw [data_2149.2.1]; decide

