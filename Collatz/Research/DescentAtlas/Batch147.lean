/-- Exact parity count, endpoint, and contracting multiplier for residue 3289. -/
theorem data_3289 : oddCount 3289 14 = 8 ∧
    acceleratedOrbit 14 3289 = 1322 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3289 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3289) = 6561 * m + 1322 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3289
  rw [data_3289.1, data_3289.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3289 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3289) < 16384 * m + 3289 := by
  apply descent_of_endpoint
  · rw [data_3289.1]; exact data_3289.2.2
  · rw [data_3289.2.1]; decide

