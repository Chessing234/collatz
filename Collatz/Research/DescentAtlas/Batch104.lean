/-- Exact parity count, endpoint, and contracting multiplier for residue 2337. -/
theorem data_2337 : oddCount 2337 14 = 7 ∧
    acceleratedOrbit 14 2337 = 314 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2337 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2337) = 2187 * m + 314 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2337
  rw [data_2337.1, data_2337.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2337 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2337) < 16384 * m + 2337 := by
  apply descent_of_endpoint
  · rw [data_2337.1]; exact data_2337.2.2
  · rw [data_2337.2.1]; decide

