/-- Exact parity count, endpoint, and contracting multiplier for residue 3609. -/
theorem data_3609 : oddCount 3609 14 = 8 ∧
    acceleratedOrbit 14 3609 = 1448 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3609 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3609) = 6561 * m + 1448 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3609
  rw [data_3609.1, data_3609.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3609 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3609) < 16384 * m + 3609 := by
  apply descent_of_endpoint
  · rw [data_3609.1]; exact data_3609.2.2
  · rw [data_3609.2.1]; decide

