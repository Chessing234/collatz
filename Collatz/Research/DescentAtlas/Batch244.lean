/-- Exact parity count, endpoint, and contracting multiplier for residue 5481. -/
theorem data_5481 : oddCount 5481 14 = 6 ∧
    acceleratedOrbit 14 5481 = 244 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_5481 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5481) = 729 * m + 244 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 5481
  rw [data_5481.1, data_5481.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_5481 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 5481) < 16384 * m + 5481 := by
  apply descent_of_endpoint
  · rw [data_5481.1]; exact data_5481.2.2
  · rw [data_5481.2.1]; decide

