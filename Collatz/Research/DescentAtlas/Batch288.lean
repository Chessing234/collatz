    acceleratedOrbit 14 6461 = 2591 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_6461 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6461) = 6561 * m + 2591 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 6461
  rw [data_6461.1, data_6461.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_6461 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 6461) < 16384 * m + 6461 := by
  apply descent_of_endpoint
  · rw [data_6461.1]; exact data_6461.2.2
  · rw [data_6461.2.1]; decide

