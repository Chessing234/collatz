/-- Exact parity count, endpoint, and contracting multiplier for residue 923. -/
theorem data_923 : oddCount 923 14 = 8 ∧
    acceleratedOrbit 14 923 = 371 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_923 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 923) = 6561 * m + 371 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 923
  rw [data_923.1, data_923.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_923 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 923) < 16384 * m + 923 := by
  apply descent_of_endpoint
  · rw [data_923.1]; exact data_923.2.2
  · rw [data_923.2.1]; decide

