/-- Exact parity count, endpoint, and contracting multiplier for residue 4079. -/
theorem data_4079 : oddCount 4079 14 = 8 ∧
    acceleratedOrbit 14 4079 = 1634 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_4079 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4079) = 6561 * m + 1634 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 4079
  rw [data_4079.1, data_4079.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_4079 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 4079) < 16384 * m + 4079 := by
  apply descent_of_endpoint
  · rw [data_4079.1]; exact data_4079.2.2
  · rw [data_4079.2.1]; decide

