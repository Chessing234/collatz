/-- Exact parity count, endpoint, and contracting multiplier for residue 205. -/
theorem data_205 : oddCount 205 14 = 6 ∧
    acceleratedOrbit 14 205 = 10 ∧ 729 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_205 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 205) = 729 * m + 10 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 205
  rw [data_205.1, data_205.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_205 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 205) < 16384 * m + 205 := by
  apply descent_of_endpoint
  · rw [data_205.1]; exact data_205.2.2
  · rw [data_205.2.1]; decide

