/-- Exact parity count, endpoint, and contracting multiplier for residue 2875. -/
theorem data_2875 : oddCount 2875 14 = 8 ∧
    acceleratedOrbit 14 2875 = 1154 ∧ 6561 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_2875 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2875) = 6561 * m + 1154 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 2875
  rw [data_2875.1, data_2875.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_2875 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 2875) < 16384 * m + 2875 := by
  apply descent_of_endpoint
  · rw [data_2875.1]; exact data_2875.2.2
  · rw [data_2875.2.1]; decide

