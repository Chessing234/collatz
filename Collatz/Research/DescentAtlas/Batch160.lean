import Collatz.Research.DescentAtlas.Core

/-! Batch 160: eight disjoint odd residue classes modulo 16384.
Generated by scripts/descent_atlas.py. Every numerical claim uses kernel decide.
These are finite-horizon certificates, not a proof of universal descent. -/
namespace Collatz.Research.DescentAtlas.Batch160
open Collatz.Research.DescentAtlas

/-- Exact parity count, endpoint, and contracting multiplier for residue 3589. -/
theorem data_3589 : oddCount 3589 14 = 7 ∧
    acceleratedOrbit 14 3589 = 481 ∧ 2187 < 16384 := by
  decide

/-- The orbit formula covers every member of this infinite arithmetic progression. -/
theorem affine_3589 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3589) = 2187 * m + 481 := by
  have h := Congruence.accOrbit_pow_two_mul_add 14 m 3589
  rw [data_3589.1, data_3589.2.1] at h
  exact h

/-- Strict descent for all class indices, including the representative itself. -/
theorem descent_3589 (m : Nat) :
    acceleratedOrbit 14 (16384 * m + 3589) < 16384 * m + 3589 := by
  apply descent_of_endpoint
  · rw [data_3589.1]; exact data_3589.2.2
  · rw [data_3589.2.1]; decide

