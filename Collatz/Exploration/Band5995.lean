import Collatz.Exploration.CoefficientBand

/-! A kernel-checked 5754-step coefficient profile yields a fixed-width
5995/1000 band obstruction for an infinite class of integer sources. -/
set_option exponentiation.threshold 10000
set_option maxRecDepth 100000

namespace Collatz.Exploration.Band5995
open CoefficientBand

def seed5754 : Nat := 

set_option maxRecDepth 100000 in
theorem seed5754_lt : seed5754 < 2^5754 := by decide

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem coefficient_profile : coefficientCheck 119899 20000 5754 seed5754 1 1 = true := by decide

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem count_profile : prefixOdds 5754 seed5754 = 3631 := by decide

theorem exact_odd_count : oddCount seed5754 5754 = 3631 := by
  rw [← prefixOdds_eq, count_profile]

theorem seed5754_positive : 1 < seed5754 := by decide

theorem seed5754_budget : 119899*5754+20000 ≤ 1*seed5754 := by decide

/-- Every size threshold admits a compact finite survivor in the fixed width 1199/200. -/
theorem fixed_width_witness (N : Nat) :
    ∃ n, N < n ∧ 1 < n ∧ n ≤ N+2^5754 ∧
      ∀ k, k ≤ 9385 → n ≤ orbit k n ∧ 200*orbit k n ≤ 1199*n := by
  obtain ⟨n,hN,hn,hsize,hprefix⟩ := bounded_gap_witness (G := 1) seed5754_lt
    coefficient_profile (by decide) seed5754_budget seed5754_positive N
  refine ⟨n,hN,hn,hsize,?_⟩
  intro k hk
  have hv := hprefix k (by rw [exact_odd_count]; omega)
  exact ⟨hv.1,by omega⟩

theorem no_fixed_width_clock : ¬ BandClock.ExitClock 1199 200 9385 := by
  intro hc
  obtain ⟨n,_,hn,_,hp⟩ := fixed_width_witness 0
  exact BandClock.no_band_through hc hn hp

theorem fixed_width_clock_lower {H : Nat} (hc : BandClock.ExitClock 1199 200 H) :
    9385 < H := by
  by_cases hH : 9385 < H
  · exact hH
  obtain ⟨n,_,hn,_,hp⟩ := fixed_width_witness 0
  exact False.elim (BandClock.no_band_through hc hn (fun k hk => hp k (by omega)))

end Collatz.Exploration.Band5995
